<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Süreç Takibi | BERLINER Aday Portalı</title>
    <%- include('partials/cand_head') %>
    <style>
        .tl { position: relative; padding: 8px 20px 8px 20px; }
        .tl-item { display: flex; gap: 16px; position: relative; padding-bottom: 22px; }
        .tl-item:last-child { padding-bottom: 0; }
        .tl-item::before { content: ''; position: absolute; left: 21px; top: 44px; bottom: 0; width: 2px; background: #E4E7EC; }
        .tl-item:last-child::before { display: none; }
        .tl-item.done::before { background: var(--brand); }
        .tl-m { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; flex-shrink: 0; background: #F2F4F7; color: #98A2B3; font-size: 16px; position: relative; z-index: 1; }
        .tl-item.done .tl-m { background: var(--brand); color: #fff; }
        .tl-item.cur .tl-m { background: #fff; color: var(--brand); border: 2px solid var(--brand); box-shadow: 0 0 0 6px rgba(47,84,235,.12); }
        .tl-body { flex: 1; padding: 10px 14px; border-radius: 12px; }
        .tl-item.cur .tl-body { background: var(--brand-50); border: 1px solid var(--brand-100); }
        .tl-item.todo .tl-body h3 { color: #667085; }
        .tl-body h3 { font-size: 15px; font-weight: 700; margin: 0 0 3px; }
    </style>
</head>
<body>
<% const next = currentIndex >= 0 && currentIndex < processDetails.length - 1 ? processDetails[currentIndex + 1] : null; const cur = processDetails[currentIndex]; %>
<%- include('partials/cand_shell_start', { page: 'processes', title: 'Süreç Takibi', subtitle: 'Başvurunun hangi aşamada olduğunu adım adım takip et' }) %>

<section class="hero mb-3">
    <div class="row align-items-center g-4 position-relative" style="z-index:1">
        <div class="col-lg-8">
            <div class="small fw-semibold text-uppercase mb-2" style="color:rgba(255,255,255,.6);letter-spacing:1px">Mevcut aşaman · <%= currentIndex + 1 %> / <%= processDetails.length %></div>
            <h2 class="mb-2" style="font-size:28px"><%= user.currentStage %></h2>
            <p class="mb-0" style="color:rgba(255,255,255,.75)"><%= cur ? cur.desc : '' %><% if (next) { %> Sıradaki adım: <strong style="color:#fff"><%= next.name %></strong> (tahmini <%= next.time %>).<% } %></p>
        </div>
        <div class="col-lg-4">
            <div class="p-3" style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:14px">
                <div class="d-flex justify-content-between align-items-end mb-2"><span class="small" style="color:rgba(255,255,255,.7)">Genel ilerleme</span><span class="fs-4 fw-bold text-white">%<%= progress %></span></div>
                <div class="bar" style="background:rgba(255,255,255,.12)"><span style="width:<%= progress %>%;background:#7EA2FF"></span></div>
            </div>
        </div>
    </div>
</section>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="c-card">
            <div class="c-card-h"><h2>Süreç Adımları</h2></div>
            <div class="tl py-4">
                <% processDetails.forEach((p, i) => { const st = i < currentIndex ? 'done' : i === currentIndex ? 'cur' : 'todo'; %>
                <div class="tl-item <%= st %>">
                    <div class="tl-m"><i class="fas <%= st === 'done' ? 'fa-check' : p.icon %>"></i></div>
                    <div class="tl-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                            <h3><%= p.name %></h3>
                            <% if (st === 'done') { %><span class="pill t-ok"><i class="fas fa-check"></i> Tamamlandı</span>
                            <% } else if (st === 'cur') { %><span class="pill t-brand"><span class="d"></span> Devam ediyor</span>
                            <% } else { %><span class="pill t-gray"><i class="far fa-clock"></i> <%= p.time %></span><% } %>
                        </div>
                        <div class="small muted"><%= p.desc %></div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="c-card mb-3 c-card-b">
            <h3 class="fs-6 fw-bold mb-3"><i class="fas fa-lightbulb me-2" style="color:var(--warn)"></i>Süreci hızlandırmak için</h3>
            <div class="d-flex flex-column gap-3 small">
                <a href="/documents" class="d-flex gap-2 text-decoration-none text-reset"><i class="fas fa-folder-open mt-1" style="color:var(--brand)"></i><span><b>Belgelerini eksiksiz yükle.</b><br><span class="muted">Reddedilen belgeleri hemen yenile.</span></span></a>
                <a href="/application-form" class="d-flex gap-2 text-decoration-none text-reset"><i class="fas fa-file-signature mt-1" style="color:var(--brand)"></i><span><b>Başvuru formunu doldur.</b><br><span class="muted">Vize dosyanın temelini oluşturur.</span></span></a>
                <a href="/german" class="d-flex gap-2 text-decoration-none text-reset"><i class="fas fa-language mt-1" style="color:var(--brand)"></i><span><b>Almancanı geliştir.</b><br><span class="muted">İşveren görüşmelerinde fark yaratır.</span></span></a>
            </div>
        </div>
        <a href="/germany-process" class="c-card c-card-b d-flex align-items-center gap-3 text-decoration-none text-reset">
            <div class="c-ic t-ok"><i class="fas fa-plane-departure"></i></div>
            <div class="flex-grow-1"><div class="fw-650 text-dark">Almanya Süreci</div><div class="small muted">Varış sonrası entegrasyon adımları</div></div>
            <i class="fas fa-chevron-right muted"></i>
        </a>
    </div>
</div>

<%- include('partials/cand_shell_end', { page: 'processes' }) %>
</body>
</html>
