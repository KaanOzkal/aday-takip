<%
    const base = (typeof onMain !== 'undefined' && onMain) ? '' : '/admin';
    const s = (typeof stats !== 'undefined' && stats) ? stats : {};
    const act = (typeof active !== 'undefined') ? active : '';
%>
<aside class="sidebar" id="sidebar">
    <a class="brand" href="/admin#dashboard">
        <div class="brand-mark">B</div>
        <div class="brand-text"><strong>BERLINER</strong><small>Aday Takip Sistemi</small></div>
    </a>

    <div class="side-label">Genel</div>
    <ul class="side-nav">
        <li><a href="<%= base %>#dashboard" data-section="dashboard" class="<%= act === 'dashboard' ? 'active' : '' %>"><i class="fas fa-chart-pie"></i> Genel Bakış</a></li>
        <li><a href="<%= base %>#candidates" data-section="candidates" class="<%= act === 'candidates' ? 'active' : '' %>"><i class="fas fa-users"></i> Adaylar
            <% if (s.total !== undefined) { %><span class="count neutral"><%= s.total %></span><% } %></a></li>
    </ul>

    <div class="side-label">İş Akışı</div>
    <ul class="side-nav">
        <li><a href="<%= base %>#documents" data-section="documents" class="<%= act === 'documents' ? 'active' : '' %>"><i class="fas fa-file-shield"></i> Belge Onayları
            <% if (s.pendingDocs) { %><span class="count"><%= s.pendingDocs %></span><% } %></a></li>
        <li><a href="<%= base %>#appointments" data-section="appointments" class="<%= act === 'appointments' ? 'active' : '' %>"><i class="fas fa-calendar-check"></i> Randevular
            <% if (s.pendingAppointments) { %><span class="count"><%= s.pendingAppointments %></span><% } %></a></li>
        <li><a href="<%= base %>#companies" data-section="companies" class="<%= act === 'companies' ? 'active' : '' %>"><i class="fas fa-building"></i> Şirketler</a></li>
    </ul>

    <div class="side-label">İletişim</div>
    <ul class="side-nav">
        <li><a href="<%= base %>#communication" data-section="communication" class="<%= act === 'communication' ? 'active' : '' %>"><i class="fas fa-bullhorn"></i> Duyuru &amp; E-posta</a></li>
    </ul>

    <div class="side-label">Araçlar</div>
    <ul class="side-nav">
        <li><a href="/admin/export.csv"><i class="fas fa-file-csv"></i> Excel'e Aktar (CSV)</a></li>
        <li><a href="/admin/sync-drive-files" class="js-confirm" data-confirm="Eski Drive klasörü taranacak ve ad + soyad eşleşen dosyalar adaylara eklenecek. Bu işlem biraz sürebilir."><i class="fab fa-google-drive"></i> Drive Eşitle</a></li>
    </ul>

    <div class="sidebar-foot">
        <div class="me">
            <div class="av">A</div>
            <div class="flex-grow-1" style="line-height:1.2">
                <div class="fw-semibold" style="font-size:13px">Yönetici</div>
                <small style="color:#7C8BA5;font-size:11.5px">Tam yetki</small>
            </div>
            <a href="/admin/logout" class="btn btn-sm btn-icon" style="color:#B6C2D6;background:#111A2E;border:1px solid #1E293B" title="Çıkış yap"><i class="fas fa-arrow-right-from-bracket"></i></a>
        </div>
    </div>
</aside>
<div class="backdrop" id="backdrop"></div>
