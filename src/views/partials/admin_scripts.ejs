<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    // ---- Mobil menü ----
    const sb = document.getElementById('sidebar'), bd = document.getElementById('backdrop');
    document.querySelectorAll('.menu-toggle').forEach(b => b.addEventListener('click', () => { sb.classList.toggle('open'); bd.classList.toggle('show'); }));
    bd && bd.addEventListener('click', () => { sb.classList.remove('open'); bd.classList.remove('show'); });

    // ---- Bildirimler ----
    const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 3200, timerProgressBar: true });
    const OK = {
        bulk_success: 'Duyuru adayların paneline gönderildi.',
        bulk_mail_success: 'Toplu e-postalar gönderildi.',
        bulk_done: 'Toplu işlem tamamlandı.',
        note_added: 'Not eklendi.', note_deleted: 'Not silindi.',
        company_created: 'Şirket oluşturuldu.', company_deleted: 'Şirket silindi.', company_updated: 'Şirket bilgisi güncellendi.',
        mail_success: 'E-posta iletildi.', message_sent: 'Mesaj adayın paneline gönderildi.', message_deleted: 'Mesaj silindi.',
        integration_updated: 'Entegrasyon adımları kaydedildi.', updated: 'Süreç güncellendi.',
        document_updated: 'Belge durumu güncellendi.', document_deleted: 'Belge kaydı silindi.',
        appointment_updated: 'Randevu durumu güncellendi.',
        candidate_created: 'Aday oluşturuldu. Giriş bilgisi: Ad + Soyad + Pasaport No.',
        candidate_updated: 'Aday bilgileri kaydedildi.', candidate_deleted: 'Aday silindi.',
        staff_created: 'Personel oluşturuldu.', staff_updated: 'Personel bilgileri kaydedildi.', staff_passive: 'Personel pasife alındı, oturumları kapatıldı.',
        staff_active: 'Personel aktifleştirildi.', staff_deleted: 'Personel devre dışı bırakıldı. Geçmiş kayıtları korunuyor.', staff_restored: 'Personel geri yüklendi (pasif).',
        password_reset: 'Şifre sıfırlandı, açık oturumlar kapatıldı.',
        wo_created: 'İş emri oluşturuldu ve personele bildirildi.', wo_updated: 'İş emri güncellendi, personele bildirildi.', no_change: 'Değişiklik yapılmadı.',
        wo_cancel: 'İş emri iptal edildi.', wo_revision: 'Görev revizyona gönderildi.', wo_approve: 'Görev onaylandı.', wo_reopen: 'İş emri yeniden açıldı.',
        comment_added: 'Açıklama eklendi, personele bildirildi.', file_added: 'Dosya eklendi.', all_read: 'Tüm bildirimler okundu olarak işaretlendi.',
        stage_moved: 'Aşama değiştirildi ve süreç geçmişine kaydedildi.', stage_moved_auto: 'Aşama değiştirildi; aşamanın görevleri otomatik oluşturulup personele atandı.',
        stage_moved_autofail: 'Aşama değiştirildi ancak bazı otomatik görevler oluşturulamadı. Otomasyon kayıtlarını kontrol edin.', stage_updated: 'Aşama bilgisi güncellendi.',
        auto_paused: 'Bu aday için otomasyon durduruldu.', auto_resumed: 'Otomasyon yeniden başlatıldı.', auto_ran: 'Otomasyon çalıştı, görevler oluşturuldu.',
        auto_nothing: 'Oluşturulacak yeni görev yok (görevler zaten mevcut veya otomasyon kapalı).', auto_failed: 'Otomasyon tamamlanamadı. Sorumlu personel ayarlarını kontrol edin.',
        auto_saved: 'Otomasyon ayarları kaydedildi.', tpl_added: 'Görev şablonu eklendi.', tpl_saved: 'Görev şablonu güncellendi.', tpl_deleted: 'Görev şablonu silindi.', log_resolved: 'Kayıt çözüldü olarak işaretlendi.',
        candidate_cancelled: 'Aday iptal durumuna alındı. Süreç geçmişi korunuyor.', candidate_reactivated: 'Aday yeniden aktifleştirildi.',
        legacy_resolved: 'Seçilen adayların aşaması onaylandı (' + (new URLSearchParams(location.search).get('n') || 0) + ' aday).',
        company_converted: 'Grup iptal durumuna dönüştürüldü (' + (new URLSearchParams(location.search).get('n') || 0) + ' aday iptal edildi).',
        orphans_cleaned: 'Silinmiş adaylara ait açık görevler iptal edildi.', contact_added: 'İletişim kaydı eklendi.',
        wo_group_created: 'Ortak iş emri oluşturuldu; seçilen her personele ayrı görev atandı ve bildirildi.',
        category_created: 'Kategori eklendi.', category_updated: 'Kategori güncellendi.', category_deleted: 'Kategori silindi.', category_deactivated: 'Kategori kullanımda olduğu için silinmedi, pasife alındı.',
        recurring_created: 'Tekrarlayan görev oluşturuldu.', recurring_updated: 'Tekrarlayan görev güncellendi.', recurring_deleted: 'Tekrarlayan görev silindi.',
        recurring_paused: 'Tekrarlayan görev durduruldu.', recurring_resumed: 'Tekrarlayan görev yeniden başlatıldı.', recurring_ran: 'Kural çalıştırıldı, iş emirleri oluşturuldu.',
        announcement_created: 'Duyuru yayınlandı ve personele bildirildi.',
        dossier_saved: 'Aday bilgileri kaydedildi.', verified: 'Bölüm doğrulandı; aday artık bu bölümü değiştiremez.', unverified: 'Doğrulama kaldırıldı; aday bölümü yeniden düzenleyebilir.',
        payment_marked: 'Ödeme aday dosyasına eklendi ve adaya bildirildi.', payment_unmarked: 'Ödeme işareti kaldırıldı (geçmiş korunuyor).', receipt_uploaded: 'Dekont yüklendi, onayınızı bekliyor.',
        payment_approved: 'Dekont onaylandı; ödeme tamamlandı olarak işaretlendi.', payment_rejected: 'Dekont reddedildi; adaya bildirildi.',
        document_uploaded: 'Belge arşive eklendi.', document_updated: 'Belge kategorisi güncellendi.', cv_saved: 'CV bilgileri kaydedildi.', announcement_updated: 'Duyuru güncellendi.', announcement_deleted: 'Duyuru silindi.'
    };
    const ERR = {
        company_exists: 'Bu isimde bir şirket zaten var.',
        mail_yok: 'Adayın kayıtlı e-posta adresi yok.',
        mail_fail: 'E-posta gönderilemedi. SMTP ayarlarını (EMAIL_USER / EMAIL_PASS) kontrol edin.',
        bulk_mail_fail: 'Toplu e-posta gönderilemedi. SMTP ayarlarını kontrol edin.',
        no_candidates: 'Seçilen kitlede aday bulunamadı.',
        passport_exists: 'Bu pasaport numarasıyla kayıtlı bir aday zaten var.',
        missing_fields: 'Lütfen zorunlu alanları doldurun.',
        no_selection: 'Önce en az bir aday seçin.',
        not_found: 'Kayıt bulunamadı.',
        drive_empty: 'Drive klasöründe dosya bulunamadı.',
        sync_failed: 'Drive eşitleme başarısız. Eski Drive kimlik bilgilerini kontrol edin.',
        bad_username: 'Kullanıcı adı 3-40 karakter olmalı; yalnızca küçük harf, rakam, nokta, tire ve alt çizgi içerebilir.',
        username_taken: 'Bu kullanıcı adı zaten kullanılıyor.',
        bad_email: 'Geçerli bir e-posta adresi girin.',
        weak_password: 'Şifre en az 8 karakter olmalı ve en az bir harf ile bir rakam içermeli.',
        staff_inactive: 'Seçilen personel aktif değil. Lütfen aktif bir personel seçin.',
        bad_date: 'Tarihleri kontrol edin. Son teslim tarihi başlangıç tarihinden önce olamaz.',
        note_required: 'Revizyon nedeni yazmanız gerekiyor.',
        invalid_action: 'Bu işlem görevin mevcut durumunda yapılamaz.',
        no_file: 'Lütfen bir dosya seçin.', bad_type: 'Bu dosya türü desteklenmiyor (PDF, görsel, Word, Excel).',
        too_large: 'Dosya 5 MB\'dan büyük olamaz.', upload_failed: 'Dosya yüklenemedi. Google Drive bağlantısını kontrol edin.',
        needs_confirm: 'Bu geçiş için onay ve gerekçe gerekiyor.', reason_required: 'Aşama atlamak veya geri almak için gerekçe yazmalısınız.', same_stage: 'Aday zaten bu aşamada.',
        cancel_reason_required: 'İptal için en az 3 karakterlik bir neden yazmalısınız.', already_cancelled: 'Aday zaten iptal durumunda.',
        candidate_cancelled_locked: 'İptal edilmiş adayda aşama değiştirilemez. Önce adayı yeniden aktifleştirin.', rate_limited: 'Çok fazla istek gönderildi. Lütfen biraz bekleyin.',
        bad_category: 'Geçerli bir kategori seçin.', category_exists: 'Bu isimde bir kategori zaten var.', last_category: 'En az bir aktif kategori kalmalıdır.', create_failed: 'İş emri oluşturulamadı.',
        bad_passport: 'Pasaport numarası geçersiz.', passport_required: 'Pasaport numarası boş bırakılamaz.', bad_tc: 'T.C. kimlik numarası geçersiz.', bad_birthdate: 'Doğum tarihi geçersiz.', bad_children: 'Çocuk sayısı geçersiz.', bad_phone: 'Telefon numarası geçersiz.', end_required: 'Bitiş tarihi girin veya "Halen" seçin.',
        verify_incomplete: 'Eksik alanları olan bölüm doğrulanamaz.', payment_approved_locked: 'Onaylanmış ödeme değiştirilemez.', payment_not_marked: 'Önce ödemeyi aday için işaretleyin.', receipt_required: 'Dekont yüklenmeden ödeme onaylanamaz.', reason_required_payment: 'Ret nedeni yazmalısınız.', bad_photo: 'Fotoğraf JPG/PNG ve en fazla 2 MB olmalı.'
    };
    const p = new URLSearchParams(location.search);
    const st = p.get('status'), er = p.get('error');
    if (st) {
        let m;
        if (st.startsWith('sync_')) m = `Drive eşitlendi: ${st.split('_')[1]} yeni dosya eşleşti.`;
        else if (st.startsWith('bulk_mail_partial_')) { const [, , , a, b] = st.split('_'); m = `${a} e-posta gönderildi, ${b} başarısız.`; }
        else m = OK[st] || 'İşlem başarılı.';
        Toast.fire({ icon: st.startsWith('bulk_mail_partial_') ? 'warning' : 'success', title: m });
    } else if (er) {
        Swal.fire({ icon: 'error', title: 'İşlem tamamlanamadı', text: ERR[er] || 'Beklenmeyen bir sorun oluştu. Lütfen tekrar deneyin.', confirmButtonColor: '#D4111B' });
    }
    if (st || er) { p.delete('status'); p.delete('error'); const q = p.toString(); history.replaceState(null, '', location.pathname + (q ? '?' + q : '') + location.hash); }

    // ---- Onay pencereleri (form ve linkler) ----
    async function ask(text, danger) {
        const r = await Swal.fire({ icon: danger ? 'warning' : 'question', title: 'Emin misiniz?', text, showCancelButton: true,
            confirmButtonText: danger ? 'Evet, devam et' : 'Onayla', cancelButtonText: 'Vazgeç',
            confirmButtonColor: danger ? '#F04438' : '#D4111B', reverseButtons: true });
        return r.isConfirmed;
    }
    window.adminAsk = ask;
    document.addEventListener('submit', async e => {
        const f = e.target;
        if (!f.matches('form[data-confirm]') || f.dataset.confirmed) return;
        e.preventDefault();
        if (await ask(f.dataset.confirm, f.hasAttribute('data-danger'))) { f.dataset.confirmed = '1'; showBusy(f); f.submit(); }
    });
    document.addEventListener('click', async e => {
        const a = e.target.closest('a.js-confirm');
        if (!a) return;
        e.preventDefault();
        if (await ask(a.dataset.confirm)) location.href = a.href;
    });
    // Gönderimde butonu kilitle (çift tıklamayı engelle)
    function showBusy(f) {
        const b = f.querySelector('button[type=submit], button:not([type])');
        if (b && !b.dataset.noBusy) { b.disabled = true; b.dataset.orig = b.innerHTML; b.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> İşleniyor'; }
    }
    document.addEventListener('submit', e => { if (!e.defaultPrevented && !e.target.matches('form[data-confirm]')) showBusy(e.target); });

    // ---- Gerçek zamanlı bildirimler (SSE, olmazsa periyodik yenileme) ----
    const setUnread = (n) => document.querySelectorAll('.js-admin-unread').forEach(b => { b.textContent = n; b.hidden = !n; });
    window.adminSetUnread = setUnread;
    const showNotif = (d) => {
        Toast.fire({ icon: 'info', title: d.title, text: d.message, timer: 6000 }).then(r => { if (r.isConfirmed) location.href = d.link; });
        try { if ('Notification' in window && Notification.permission === 'granted' && document.hidden) { const n = new Notification('BERLINER · ' + d.title, { body: d.message, tag: d.id }); n.onclick = () => { window.focus(); location.href = d.link; }; } } catch (e) {}
    };
    let polling = null, lastUnread = null;
    const poll = () => fetch('/admin/api/unread', { headers: { Accept: 'application/json' } }).then(r => r.ok ? r.json() : null).then(d => { if (!d) return; if (lastUnread !== null && d.unread > lastUnread) Toast.fire({ icon: 'info', title: 'Yeni bildiriminiz var' }); lastUnread = d.unread; setUnread(d.unread); }).catch(() => {});
    if (window.EventSource) {
        const es = new EventSource('/admin/bildirimler/stream');
        es.addEventListener('notification', ev => { const d = JSON.parse(ev.data); setUnread(d.unread); showNotif(d); document.dispatchEvent(new CustomEvent('admin:notification', { detail: d })); });
        es.addEventListener('unread', ev => setUnread(JSON.parse(ev.data).unread));
        es.onerror = () => { if (!polling) { polling = setInterval(poll, 30000); } };
        es.onopen = () => { if (polling) { clearInterval(polling); polling = null; } };
    } else { polling = setInterval(poll, 30000); }
})();
</script>
