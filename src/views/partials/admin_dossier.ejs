    <div class="modal-footer"><button type="button" class="btn btn-soft" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-brand">Kaydet</button></div>
</form></div></div>
<script>
(function () {
    document.body.appendChild(document.getElementById('dEntryModal')); // modal, yerleşim katmanlarının üstünde açılsın
    document.querySelectorAll('.js-paytoggle').forEach(cb => cb.addEventListener('change', () => cb.form.submit()));
    const f = document.getElementById('dEntryForm'), titles = { work: 'İş deneyimi', education: 'Eğitim', certificates: 'Sertifika' };
    const open = (kind, e) => {
        f.reset(); f.action = '<%= act %>/dossier/' + kind; f.elements.id.value = '';
        f.querySelectorAll('.k-work,.k-education,.k-certificates,.k-we').forEach(el => { const show = el.classList.contains('k-' + kind) || (el.classList.contains('k-we') && kind !== 'certificates'); el.hidden = !show; el.querySelectorAll('input,textarea').forEach(i => i.disabled = !show); });
        if (e) Object.entries(e).forEach(([k, v]) => { const el = f.elements[k]; if (!el || el.disabled) return; if (el.type === 'checkbox') el.checked = !!v; else el.value = v || ''; });
        document.getElementById('dEntryTitle').textContent = titles[kind] + (e ? ' · düzenle' : ' · ekle');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('dEntryModal')).show();
    };
    document.querySelectorAll('.js-dadd').forEach(b => b.addEventListener('click', () => open(b.dataset.kind)));
    document.querySelectorAll('.js-dedit').forEach(b => b.addEventListener('click', () => open(b.dataset.kind, JSON.parse(b.dataset.e))));
})();
</script>
<% } %>
