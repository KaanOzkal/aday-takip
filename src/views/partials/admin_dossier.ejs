        <div class="col-12 k-work"><label class="form-label small">Tätigkeitsbeschreibung (DE)</label><textarea name="descriptionDe" rows="2" class="form-control form-control-sm"></textarea></div>
        <div class="col-md-6 k-education"><label class="form-label small">Abschluss (DE)</label><input name="degreeDe" class="form-control form-control-sm"></div>
