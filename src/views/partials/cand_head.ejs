<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0B1220">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.8/dist/sweetalert2.all.min.js"></script>
<style>
    :root {
        --brand: #2F54EB; --brand-600: #2343C9; --brand-50: #EEF2FF; --brand-100: #E0E7FF;
        --ink: #0F172A; --ink-2: #334155; --muted: #64748B; --line: #E6E9F0;
        --bg: #F5F7FB; --surface: #FFFFFF; --navy: #0B1220;
        --ok: #12B76A; --ok-50: #ECFDF3; --warn: #F79009; --warn-50: #FFFAEB;
        --bad: #F04438; --bad-50: #FEF3F2; --info: #0BA5EC; --info-50: #F0F9FF;
        --gold: #FFCE00;
        --radius: 16px; --side-w: 264px;
        --bs-body-font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
        --bs-primary: #2F54EB; --bs-primary-rgb: 47, 84, 235;
    }
    html, body { background: var(--bg); }
    body { font-family: var(--bs-body-font-family); color: var(--ink-2); font-size: 14.5px; -webkit-font-smoothing: antialiased; }
    h1, h2, h3, h4, h5, h6 { color: var(--ink); letter-spacing: -.2px; }
    a { color: var(--brand); }

    /* ---------- SHELL ---------- */
    .c-side {
        position: fixed; inset: 0 auto 0 0; width: var(--side-w); background: var(--surface); border-right: 1px solid var(--line);
        display: flex; flex-direction: column; z-index: 1045; transition: transform .25s ease;
    }
    .c-brand { display: flex; align-items: center; gap: 12px; padding: 20px 22px; text-decoration: none; border-bottom: 1px solid var(--line); }
    .c-brand img { width: 40px; height: 40px; object-fit: contain; }
    .c-brand .mk { width: 40px; height: 40px; border-radius: 12px; background: var(--navy); color: #fff; display: grid; place-items: center; font-weight: 800; }
    .c-brand strong { display: block; color: var(--ink); font-size: 16px; letter-spacing: .6px; line-height: 1.1; }
    .c-brand small { color: var(--muted); font-size: 11.5px; }
    .c-nav { flex: 1; overflow-y: auto; padding: 8px 12px 16px; }
    .c-nav .lbl { font-size: 11px; font-weight: 700; color: #98A2B3; text-transform: uppercase; letter-spacing: .9px; padding: 14px 12px 6px; }
    .c-nav a {
        display: flex; align-items: center; gap: 12px; padding: 9px 12px; border-radius: 10px; color: #475467; font-weight: 500;
        text-decoration: none; margin-bottom: 1px; transition: background .15s, color .15s;
    }
    .c-nav a i { width: 18px; text-align: center; color: #98A2B3; font-size: 15px; }
    .c-nav a:hover { background: #F2F4F7; color: var(--ink); }
    .c-nav a.active { background: var(--brand-50); color: var(--brand); font-weight: 600; }
    .c-nav a.active i { color: var(--brand); }
    .c-nav .badge-n { margin-left: auto; background: var(--bad); color: #fff; font-size: 11px; font-weight: 700; border-radius: 99px; padding: 1px 8px; }
    .c-side-foot { padding: 14px; border-top: 1px solid var(--line); }
    @media (max-height: 920px) { .c-side-foot { display: none; } }
    .c-help { background: var(--navy); color: #fff; border-radius: 14px; padding: 14px; font-size: 13px; }
    .c-help a { color: #fff; font-weight: 600; }

    .c-main { margin-left: var(--side-w); min-height: 100vh; }
    .c-top {
        position: sticky; top: 0; z-index: 1030; height: 68px; display: flex; align-items: center; gap: 12px; padding: 0 28px;
        background: rgba(245,247,251,.85); backdrop-filter: saturate(180%) blur(10px); border-bottom: 1px solid transparent;
    }
    .c-top.scrolled { background: rgba(255,255,255,.92); border-bottom-color: var(--line); }
    .c-top h1 { font-size: 20px; font-weight: 750; margin: 0; }
    .c-top .sub { color: var(--muted); font-size: 12.5px; }
    .c-icon-btn { width: 40px; height: 40px; border-radius: 12px; border: 1px solid var(--line); background: #fff; display: inline-grid; place-items: center; color: var(--ink-2); position: relative; text-decoration: none; }
    .c-icon-btn:hover { background: #F8FAFC; color: var(--ink); }
    .c-icon-btn .dot { position: absolute; top: -4px; right: -4px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 99px; background: var(--bad); color: #fff; font-size: 11px; font-weight: 700; display: grid; place-items: center; border: 2px solid var(--bg); }
    .c-user { display: flex; align-items: center; gap: 10px; padding: 4px 12px 4px 4px; border: 1px solid var(--line); background: #fff; border-radius: 99px; color: var(--ink); text-decoration: none; }
    .c-user .av { width: 32px; height: 32px; border-radius: 50%; background: var(--brand); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 12.5px; }
    .c-content { padding: 8px 28px 48px; max-width: 1360px; }
    .c-toggle { display: none; }
    .c-backdrop { display: none; }
    .c-bottom { display: none; }

    @media (max-width: 991.98px) {
        .c-side { transform: translateX(-100%); box-shadow: none; }
        .c-side.open { transform: none; box-shadow: 0 0 40px rgba(0,0,0,.25); }
        .c-backdrop.show { display: block; position: fixed; inset: 0; background: rgba(15,23,42,.45); z-index: 1040; }
        .c-main { margin-left: 0; padding-bottom: 76px; }
        .c-top { padding: 0 16px; height: 60px; }
        .c-top h1 { font-size: 17px; }
        .c-toggle { display: inline-grid; }
        .c-content { padding: 8px 16px 32px; }
        .c-bottom {
            display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 1035; background: #fff; border-top: 1px solid var(--line);
            padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
        }
        .c-bottom a, .c-bottom button { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 11px; font-weight: 600; color: #667085; text-decoration: none; background: none; border: 0; padding: 4px 0; position: relative; }
        .c-bottom i { font-size: 18px; }
        .c-bottom .active { color: var(--brand); }
        .c-bottom .dot { position: absolute; top: 0; left: calc(50% + 6px); min-width: 16px; height: 16px; border-radius: 99px; background: var(--bad); color: #fff; font-size: 10px; display: grid; place-items: center; padding: 0 4px; }
    }

    /* ---------- COMPONENTS ---------- */
    .c-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 1px 2px rgba(16,24,40,.04); }
    .c-card-h { padding: 18px 20px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .c-card-h h2, .c-card-h h3 { font-size: 15.5px; font-weight: 700; margin: 0; }
    .c-card-h .sub { color: var(--muted); font-size: 12.5px; margin: 2px 0 0; }
    .c-card-b { padding: 20px; }
    .c-ic { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 17px; flex-shrink: 0; }
    .t-brand { background: var(--brand-50); color: var(--brand); } .t-ok { background: var(--ok-50); color: var(--ok); }
    .t-warn { background: var(--warn-50); color: var(--warn); } .t-bad { background: var(--bad-50); color: var(--bad); }
    .t-info { background: var(--info-50); color: var(--info); } .t-gray { background: #F2F4F7; color: #475467; }
    .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 99px; white-space: nowrap; }
    .pill .d { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .muted { color: var(--muted); }
    .fw-650 { font-weight: 650; }
    .bar { height: 8px; background: #EEF1F6; border-radius: 99px; overflow: hidden; }
    .bar > span { display: block; height: 100%; background: var(--brand); border-radius: 99px; transition: width .6s ease; }
    .empty { text-align: center; padding: 44px 16px; color: var(--muted); }
    .empty .c-ic { margin: 0 auto 12px; width: 56px; height: 56px; font-size: 22px; border-radius: 16px; }

    .hero {
        border-radius: 20px; padding: 28px; color: #fff; position: relative; overflow: hidden;
        background: radial-gradient(1200px 300px at 100% 0%, rgba(59,108,255,.45), transparent 60%), linear-gradient(135deg, #0B1220 0%, #172554 100%);
    }
    .hero::after { content: ''; position: absolute; right: -60px; bottom: -60px; width: 240px; height: 240px; border-radius: 50%; border: 40px solid rgba(255,255,255,.04); }
    .hero h2 { color: #fff; font-weight: 800; letter-spacing: -.5px; }
    .hero .flag { display: inline-flex; height: 4px; width: 54px; border-radius: 4px; overflow: hidden; }
    .hero .flag span { flex: 1; }

    .btn { font-weight: 600; border-radius: 11px; font-size: 14px; padding: .55rem 1rem; }
    .btn-sm { padding: .35rem .75rem; font-size: 13px; border-radius: 9px; }
    .btn-brand { background: var(--brand); color: #fff; border: 1px solid var(--brand); }
    .btn-brand:hover, .btn-brand:focus { background: var(--brand-600); border-color: var(--brand-600); color: #fff; }
    .btn-soft { background: #fff; border: 1px solid var(--line); color: var(--ink-2); }
    .btn-soft:hover { background: #F8FAFC; border-color: #D0D5DD; color: var(--ink); }
    .btn-primary { background: var(--brand); border-color: var(--brand); }
    .btn-primary:hover { background: var(--brand-600); border-color: var(--brand-600); }

    .form-control, .form-select { border-radius: 11px; border-color: #D0D5DD; font-size: 14.5px; padding: .6rem .85rem; }
    .form-control:focus, .form-select:focus { border-color: #8EA6FF; box-shadow: 0 0 0 4px rgba(47,84,235,.12); }
    .form-label { font-weight: 600; font-size: 13px; color: var(--ink-2); margin-bottom: 6px; }
    .form-check-input:checked { background-color: var(--brand); border-color: var(--brand); }

    .nav-pills { gap: 6px; flex-wrap: wrap; }
    .nav-pills .nav-link { border-radius: 10px; color: #475467; font-weight: 600; background: #fff; border: 1px solid var(--line); padding: .5rem 1rem; }
    .nav-pills .nav-link:hover { color: var(--ink); background: #F8FAFC; }
    .nav-pills .nav-link.active { background: var(--brand); border-color: var(--brand); color: #fff; }
    .card { border-radius: var(--radius); border-color: var(--line); }
    .fade-up { animation: fadeUp .35s ease both; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
</style>
