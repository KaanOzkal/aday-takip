<%
    const today = new Date(Date.now() + 3 * 36e5).toISOString().slice(0, 10);
    const inAWeek = new Date(Date.now() + 7 * 864e5).toISOString().slice(0, 10);
%>
<div class="modal fade" id="<%= modalId %>" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content" action="/admin/is-emirleri" method="POST" id="<%= modalId %>Form">
            <input type="hidden" name="returnTo" value="<%= returnTo %>">
            <div class="modal-header"><h5 class="modal-title"><i class="fas fa-clipboard-list me-2 text-primary"></i>Yeni İş Emri</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <% if (!staffList.length) { %>
                    <div class="alert border-0 d-flex gap-2" style="background:var(--warn-50);color:#93370D;border-radius:12px"><i class="fas fa-circle-info mt-1"></i><div>Atanabilecek aktif personel yok. Önce <a href="/admin/personel">Personel Yönetimi</a> sayfasından personel ekleyin.</div></div>
                <% } %>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Aday *</label>
                        <% if (fixedCandidate) { %>
                            <input type="hidden" name="candidateId" value="<%= fixedCandidate.id %>">
                            <div class="form-control bg-light"><i class="fas fa-user me-2 muted"></i><%= fixedCandidate.name %></div>
                        <% } else { %>
                            <input type="search" class="form-control mb-2" placeholder="Aday ara (ad, soyad, pasaport)…" oninput="(function(i){const q=i.value.toLocaleLowerCase('tr-TR');const s=i.nextElementSibling;[...s.options].forEach((o,k)=>{if(k)o.hidden=q&&!o.dataset.s.includes(q)});})(this)">
                            <select name="candidateId" class="form-select" required size="5" style="height:auto">
                                <option value="" disabled>Aday seçin</option>
                                <% candidates.forEach(c => { const n = `${c.firstName || ''} ${c.lastName || ''}`.trim(); %>
                                    <option value="<%= c._id %>" data-s="<%= (n + ' ' + (c.passportNo || '')).toLocaleLowerCase('tr-TR') %>"><%= n %><%= c.passportNo ? ' · ' + c.passportNo : '' %></option>
                                <% }) %>
                            </select>
                        <% } %>
                    </div>
                    <div class="col-md-6"><label class="form-label">Kategori *</label>
                        <select name="category" class="form-select" required><% CATEGORIES.forEach(c => { %><option><%= c %></option><% }) %></select></div>
                    <div class="col-md-6"><label class="form-label">Atanacak personel *</label>
                        <select name="assignedTo" class="form-select" required>
                            <option value="" selected disabled>Personel seçin</option>
                            <% staffList.forEach(s => { %><option value="<%= s._id %>"><%= s.fullName %><%= s.title ? ' · ' + s.title : '' %></option><% }) %>
                        </select></div>
                    <div class="col-12"><label class="form-label">Görev başlığı *</label><input type="text" name="title" class="form-control" maxlength="160" required placeholder="Örn: Diploma yeminli tercümesini tamamla"></div>
                    <div class="col-12"><label class="form-label">Detaylı açıklama</label><textarea name="description" class="form-control" rows="4" maxlength="6000" placeholder="Yapılacak işi, beklenen çıktıyı ve dikkat edilmesi gerekenleri yazın."></textarea></div>
                    <div class="col-md-4"><label class="form-label">Öncelik</label>
                        <select name="priority" class="form-select"><% PRIORITIES.forEach(p => { %><option <%= p === 'Normal' ? 'selected' : '' %>><%= p %></option><% }) %></select></div>
                    <div class="col-md-4"><label class="form-label">Başlangıç tarihi</label><input type="date" name="startDate" class="form-control" value="<%= today %>"></div>
                    <div class="col-md-4"><label class="form-label">Son teslim tarihi</label><input type="date" name="dueDate" class="form-control" value="<%= inAWeek %>" min="<%= today %>"></div>
                    <div class="col-12"><label class="form-label">Admin notu</label><textarea name="adminNote" class="form-control" rows="2" maxlength="4000" placeholder="Personelin göreceği ek not (isteğe bağlı)"></textarea></div>
                </div>
            </div>
            <div class="modal-footer"><span class="muted small me-auto"><i class="far fa-bell me-1"></i>Personele anında bildirim gönderilir.</span><button type="button" class="btn btn-soft" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-brand" <%= staffList.length ? '' : 'disabled' %>><i class="fas fa-paper-plane me-1"></i>Oluştur ve Ata</button></div>
        </form>
    </div>
</div>
