<%- include('cand_head') %>
<style>
    /* Personel paneli: sol menü + üst çubuk (BERLINER kırmızı / beyaz / koyu gri) */
    :root { --charcoal: #1F1A21; --charcoal-2: #2A2330; --s-side: 248px; }
    body { background: #F4F5F8; }
    .s-app { display: flex; min-height: 100vh; }
    .s-side { width: var(--s-side); background: var(--charcoal); color: #D9D3DB; position: fixed; inset: 0 auto 0 0; display: flex; flex-direction: column; z-index: 1040; transition: transform .25s; }
    .s-brand { display: flex; align-items: center; gap: 12px; padding: 20px 20px 16px; color: #fff; text-decoration: none; }
    .s-brand img { width: 42px; height: 42px; border-radius: 50%; background: #fff; padding: 2px; }
    .s-brand b { display: block; font-weight: 800; letter-spacing: .8px; font-size: 15px; }
    .s-brand small { color: #F8C400; font-size: 10.5px; font-weight: 700; letter-spacing: .9px; text-transform: uppercase; }
    .s-side .lbl { font-size: 10.5px; font-weight: 700; letter-spacing: 1px; color: #8C8291; text-transform: uppercase; padding: 14px 22px 6px; }
    .s-menu { list-style: none; margin: 0; padding: 0 12px; }
    .s-menu a { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px; color: #D9D3DB; text-decoration: none; font-weight: 600; font-size: 14px; position: relative; }
    .s-menu a i { width: 18px; text-align: center; color: #A79DAB; }
    .s-menu a:hover { background: rgba(255,255,255,.05); color: #fff; }
    .s-menu a.active { background: rgba(212,17,27,.18); color: #fff; }
    .s-menu a.active::before { content: ''; position: absolute; left: -12px; top: 8px; bottom: 8px; width: 3px; border-radius: 0 3px 3px 0; background: var(--brand); }
    .s-menu a.active i { color: #FF6B72; }
    .s-menu .s-badge { margin-left: auto; }
    .s-me { margin-top: auto; padding: 14px 16px; border-top: 1px solid rgba(255,255,255,.07); display: flex; align-items: center; gap: 10px; }
    .s-me .av, .s-user .av { width: 34px; height: 34px; border-radius: 50%; background: var(--brand); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 12.5px; flex-shrink: 0; }
    .s-me a.out { margin-left: auto; color: #A79DAB; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 9px; background: rgba(255,255,255,.05); }
    .s-me a.out:hover { color: #fff; background: rgba(212,17,27,.4); }
    .s-main { flex: 1; margin-left: var(--s-side); min-width: 0; display: flex; flex-direction: column; }
    .s-top { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 1030; height: 64px; display: flex; align-items: center; gap: 12px; padding: 0 24px; }
    .s-top .ttl { font-weight: 800; font-size: 17px; color: var(--ink); }
    .s-top .ttl small { display: block; font-weight: 500; font-size: 12px; color: var(--muted); }
    .s-toggle { display: none; }
    .s-badge { min-width: 18px; height: 18px; border-radius: 99px; background: var(--brand); color: #fff; font-size: 11px; font-weight: 700; display: inline-grid; place-items: center; padding: 0 5px; }
    .s-badge[hidden] { display: none; }
    .s-bell { width: 40px; height: 40px; border-radius: 12px; display: inline-grid; place-items: center; color: var(--ink-2); background: #F4F5F8; border: 1px solid var(--line); position: relative; cursor: pointer; }
    .s-bell:hover, .s-bell[aria-expanded=true] { border-color: var(--brand); color: var(--brand); }
    .s-bell .s-badge { position: absolute; top: -6px; right: -6px; border: 2px solid #fff; }
    .s-user { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; padding: 3px 10px 3px 3px; border-radius: 99px; border: 1px solid var(--line); }
    .np { width: 380px; max-width: calc(100vw - 24px); padding: 0; border-radius: 16px; border-color: var(--line); box-shadow: 0 18px 40px -12px rgba(16,24,40,.25); overflow: hidden; }
    .np-h { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
    .np-list { max-height: 420px; overflow: auto; }
    .np-i { display: flex; gap: 10px; padding: 11px 16px; border-bottom: 1px solid #F2F3F6; text-decoration: none; color: inherit; position: relative; }
    .np-i:hover { background: #FFF8F8; }
    .np-i.unread { background: #FFF5F5; }
    .np-i.unread::before { content: ''; position: absolute; left: 6px; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; background: var(--brand); }
    .np-i .t { font-weight: 650; font-size: 13.5px; color: var(--ink); }
    .np-i .m { font-size: 12.5px; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .np-i .d { font-size: 11.5px; color: var(--muted); margin-top: 2px; }
    .np-i .rd { margin-left: auto; align-self: center; border: 0; background: transparent; color: var(--muted); width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0; }
    .np-i .rd:hover { background: #fff; color: var(--ok); }
    .np-f { display: flex; padding: 10px 16px; gap: 8px; background: #FAFAFB; }
    .s-wrap { width: 100%; max-width: 1400px; margin: 0 auto; padding: 22px 24px 56px; }
    .s-head { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
    .s-head h1 { font-size: 23px; font-weight: 800; margin: 0; letter-spacing: -.4px; }
    .s-head .sub { color: var(--muted); font-size: 13.5px; }
    .s-bottom { display: none; }
    .s-back { display: none; }
    @media (max-width: 991.98px) {
        .s-side { transform: translateX(-100%); }
        .s-side.open { transform: none; box-shadow: 0 0 60px rgba(0,0,0,.4); }
        .s-back.show { display: block; position: fixed; inset: 0; background: rgba(15,23,42,.45); z-index: 1035; }
        .s-main { margin-left: 0; }
        .s-toggle { display: inline-grid; }
        .s-top { padding: 0 14px; height: 58px; }
        .s-user .nm { display: none; }
        .s-wrap { padding: 16px 14px 90px; }
        .s-bottom { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 1035; background: #fff; border-top: 1px solid var(--line); padding: 6px 4px calc(6px + env(safe-area-inset-bottom)); }
        .s-bottom a { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 11px; font-weight: 600; color: #667085; text-decoration: none; position: relative; }
        .s-bottom i { font-size: 18px; }
        .s-bottom .active { color: var(--brand); }
        .s-bottom .s-badge { position: absolute; top: -2px; left: calc(50% + 6px); }
        .np { position: fixed !important; left: 12px !important; right: 12px !important; top: 64px !important; transform: none !important; width: auto; }
    }
    .task { display: flex; gap: 14px; align-items: center; padding: 14px 18px; border-bottom: 1px solid #F0F2F5; text-decoration: none; color: inherit; }
    .task:last-child { border-bottom: 0; }
    .task:hover { background: #FFFAFA; }
    .task .pr { width: 4px; align-self: stretch; border-radius: 4px; flex-shrink: 0; }
    .pr-Acil { background: var(--bad); } .pr-Yüksek { background: var(--warn); } .pr-Normal { background: var(--brand); } .pr-Düşük { background: #D0D5DD; }
    .seg { display: inline-flex; background: #E9EDF3; border-radius: 10px; padding: 3px; gap: 2px; flex-wrap: wrap; }
    .seg a { padding: 6px 12px; border-radius: 8px; font-weight: 600; font-size: 13px; color: #475467; text-decoration: none; white-space: nowrap; }
    .seg a.active { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(16,24,40,.08); }
    .seg a .c { color: var(--muted); font-weight: 500; margin-left: 3px; }
    .pre { white-space: pre-wrap; line-height: 1.6; word-break: break-word; }
</style>
