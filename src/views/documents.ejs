<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Belgelerim | BERLINER Aday Portalı</title>
    <%- include('partials/cand_head') %>
    <style>
        .drop { border: 2px dashed #C7D2FE; background: #F8FAFF; border-radius: 14px; padding: 26px; text-align: center; cursor: pointer; transition: all .15s; }
        .drop:hover, .drop.over { border-color: var(--brand); background: var(--brand-50); }
        .drop .c-ic { margin: 0 auto 10px; width: 52px; height: 52px; font-size: 20px; }
        .drop.has { border-style: solid; border-color: var(--ok); background: var(--ok-50); }
        .req { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px dashed var(--line); }
        .req:last-child { border-bottom: 0; }
        .doc { display: flex; align-items: center; gap: 14px; padding: 14px 20px; border-bottom: 1px solid #F0F2F5; }
        .doc:last-child { border-bottom: 0; }
        .seg { display: inline-flex; background: #F2F4F7; border-radius: 10px; padding: 3px; gap: 2px; }
        .seg button { border: 0; background: transparent; padding: 6px 12px; border-radius: 8px; font-weight: 600; font-size: 13px; color: #475467; }
        .seg button.active { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(16,24,40,.08); }
    </style>
</head>
<body>
<%
    const docs = (user.documents || []).slice().sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0));
    const required = [
        { v: 'Pasaport', i: 'fa-passport' }, { v: 'Kimlik Kartı', i: 'fa-id-card' }, { v: 'Ehliyet', i: 'fa-id-card-clip' },
        { v: 'Biyometrik Fotoğraf', i: 'fa-camera' }, { v: 'Adli Sicil', i: 'fa-gavel' }, { v: 'Diploma', i: 'fa-graduation-cap' },
        { v: 'SGK Hizmet Dökümü', i: 'fa-briefcase' }, { v: 'Sağlık Raporu', i: 'fa-file-medical' }
    ];
    const latest = (name) => docs.find(d => d.name === name);
    const reqDone = required.filter(r => { const d = latest(r.v); return d && d.status !== 'Reddedildi'; }).length;
    const groups = [
        ['Kimlik ve Kişisel', [['Pasaport','Pasaport'],['Kimlik Kartı','Kimlik Kartı / Nüfus Cüzdanı'],['Ehliyet','Sürücü Belgesi (Ehliyet)'],['Biyometrik Fotoğraf','Biyometrik Fotoğraf']]],
        ['Resmi Kayıtlar', [['Adli Sicil','Adli Sicil Kaydı'],['Nüfus Kayıt Örneği','Nüfus Kayıt Örneği (Vukuatlı)'],['İkametgah','İkametgah (Yerleşim Yeri Belgesi)'],['SGK Hizmet Dökümü','SGK Hizmet Dökümü'],['Sağlık Raporu','Sağlık Raporu']]],
        ['Eğitim ve Mesleki', [['Diploma','Diploma'],['Mezuniyet Belgesi','Mezuniyet Belgesi'],['Transkript','Transkript (Not Dökümü)'],['Diploma Eki','Diploma Eki (Supplement)'],['Sertifika','Sertifika (Dil, SRC, Mesleki Yeterlilik vb.)'],['Cv','CV']]],
        ['Diğer', [['form','Form Belgesi'],['Diğer','Diğer']]]
    ];
    const iconFor = (n) => { const r = required.find(x => x.v === n); if (r) return r.i; if (/Nüfus/.test(n)) return 'fa-users'; if (/İkamet/.test(n)) return 'fa-house'; if (/Transkript|Diploma Eki/.test(n)) return 'fa-list-ol'; if (/Sertifika/.test(n)) return 'fa-award'; if (/Mezuniyet/.test(n)) return 'fa-graduation-cap'; return 'fa-file-lines'; };
    const tone = (s) => s === 'Onaylandı' ? 't-ok' : s === 'Reddedildi' ? 't-bad' : 't-warn';
    const viewUrl = (d) => d.fileId ? `/documents/view/${d._id}` : (d.driveLink || `/uploads/${encodeURIComponent(d.filename || '')}`);
%>
<%- include('partials/cand_shell_start', { page: 'documents', title: 'Belgelerim', subtitle: 'Vize ve başvuru süreci için gerekli belgelerini yükle ve takip et' }) %>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <form class="c-card h-100" action="/documents/upload" method="POST" enctype="multipart/form-data" id="upForm">
            <div class="c-card-h"><div class="c-ic t-brand"><i class="fas fa-cloud-arrow-up"></i></div><div><h2>Yeni Belge Yükle</h2><p class="sub">PDF, JPG veya PNG · en fazla 5 MB</p></div></div>
            <div class="c-card-b">
                <label class="form-label" for="docType">1. Belge türünü seç</label>
                <select name="docType" id="docType" class="form-select mb-3" required>
                    <option value="" selected disabled>Belge türü seçin…</option>
                    <% groups.forEach(([g, opts]) => { %>
                        <optgroup label="<%= g %>"><% opts.forEach(([v, t]) => { %><option value="<%= v %>"><%= t %></option><% }) %></optgroup>
                    <% }) %>
                </select>
                <label class="form-label">2. Dosyanı seç</label>
                <label class="drop d-block mb-3" id="drop">
                    <input type="file" name="file" id="file" accept=".pdf,.jpg,.jpeg,.png,.webp,.heic,application/pdf,image/*" hidden>
                    <div class="c-ic t-brand" id="dropIc"><i class="fas fa-file-arrow-up"></i></div>
                    <div class="fw-650 text-dark" id="dropT">Dosyayı buraya sürükle veya <span style="color:var(--brand)">seç</span></div>
                    <div class="small muted" id="dropS">Telefonundan fotoğraf da çekebilirsin</div>
                </label>
                <button class="btn btn-brand w-100"><i class="fas fa-upload me-1"></i> Belgeyi Yükle</button>
            </div>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="c-card h-100">
            <div class="c-card-h">
                <div class="flex-grow-1"><h2>Temel Belgeler</h2><p class="sub"><%= reqDone %> / <%= required.length %> belge yüklendi</p></div>
                <div style="width:80px"><div class="bar"><span style="width:<%= reqDone / required.length * 100 %>%;background:var(--ok)"></span></div></div>
            </div>
            <div class="c-card-b py-2">
                <% required.forEach(r => { const d = latest(r.v); %>
                <div class="req">
                    <i class="fas <%= r.i %> muted" style="width:18px;text-align:center"></i>
                    <span class="flex-grow-1 fw-650 text-dark" style="font-size:13.5px"><%= r.v %></span>
                    <% if (!d) { %><button type="button" class="btn btn-soft btn-sm js-pick" data-v="<%= r.v %>">Yükle</button>
                    <% } else { %><span class="pill <%= tone(d.status) %>"><span class="d"></span><%= d.status %></span><% } %>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<div class="c-card">
    <div class="c-card-h">
        <div><h2>Yüklediğim Belgeler</h2><p class="sub">Toplam <%= docs.length %> belge</p></div>
        <div class="seg ms-auto" id="seg">
            <button class="active" data-v="">Tümü</button>
            <button data-v="İnceleniyor">İncelemede</button>
            <button data-v="Onaylandı">Onaylı</button>
            <button data-v="Reddedildi">Reddedilen</button>
        </div>
    </div>
    <div id="docList">
        <% if (!docs.length) { %>
            <div class="empty"><div class="c-ic t-gray"><i class="fas fa-folder-open"></i></div><div class="fw-650 text-dark">Henüz belge yüklemedin</div><div class="small">Yukarıdaki formdan ilk belgeni yükleyebilirsin.</div></div>
        <% } %>
        <% docs.forEach(d => { %>
        <div class="doc" data-status="<%= d.status %>">
            <div class="c-ic <%= tone(d.status) %>"><i class="fas <%= iconFor(d.name || '') %>"></i></div>
            <div class="flex-grow-1" style="min-width:0">
                <div class="fw-650 text-dark text-truncate"><%= d.name %></div>
                <div class="small muted text-truncate"><%= new Date(d.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }) %> · <%= d.filename %></div>
                <% if (d.status === 'Reddedildi') { %><div class="small mt-1" style="color:var(--bad)"><i class="fas fa-rotate me-1"></i>Lütfen bu belgeyi yeniden yükle.</div><% } %>
            </div>
            <span class="pill <%= tone(d.status) %> d-none d-sm-inline-flex"><span class="d"></span><%= d.status %></span>
            <a href="<%= viewUrl(d) %>" target="_blank" rel="noopener" class="btn btn-soft btn-sm"><i class="fas fa-eye"></i><span class="d-none d-md-inline ms-1">Görüntüle</span></a>
            <% if (d.status !== 'Onaylandı') { %>
            <form action="/documents/delete/<%= d._id %>" method="POST" class="m-0" data-confirm="“<%= d.name %>” belgesi silinecek.">
                <button class="btn btn-soft btn-sm" style="color:var(--bad)" title="Sil" data-no-busy><i class="fas fa-trash-can"></i></button>
            </form>
            <% } else { %>
            <span class="btn btn-sm disabled border-0" title="Onaylanan belgeler silinemez"><i class="fas fa-lock muted"></i></span>
            <% } %>
        </div>
        <% }) %>
        <div class="empty d-none" id="segEmpty">Bu filtrede belge yok.</div>
    </div>
</div>

<%- include('partials/cand_shell_end', { page: 'documents' }) %>
<script>
cNotify({
    ok: { uploaded: 'Belgen yüklendi, danışmanın inceleyecek.', deleted: 'Belge silindi.' },
    err: { no_file: 'Lütfen bir dosya seçin.', no_type: 'Lütfen belge türünü seçin.', bad_type: 'Yalnızca PDF, JPG veya PNG yükleyebilirsiniz.', too_large: 'Dosya 5 MB\'dan büyük olamaz.', upload_failed: 'Belge yüklenemedi. İnternet bağlantınızı kontrol edip tekrar deneyin.', approved_locked: 'Onaylanmış belgeler silinemez.', not_found: 'Belge bulunamadı.' }
});
(function () {
    const drop = document.getElementById('drop'), file = document.getElementById('file');
    const show = f => {
        if (!f) return;
        const big = f.size > 5 * 1024 * 1024;
        drop.classList.toggle('has', !big);
        document.getElementById('dropT').textContent = f.name;
        document.getElementById('dropS').innerHTML = big ? '<span style="color:var(--bad)">Dosya 5 MB\'dan büyük</span>' : (f.size / 1024 / 1024).toFixed(2) + ' MB · değiştirmek için tıkla';
        document.getElementById('dropIc').innerHTML = '<i class="fas ' + (big ? 'fa-triangle-exclamation' : 'fa-check') + '"></i>';
    };
    file.addEventListener('change', () => show(file.files[0]));
    ['dragenter', 'dragover'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('over'); }));
    ['dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('over'); }));
    drop.addEventListener('drop', e => { if (e.dataTransfer.files.length) { file.files = e.dataTransfer.files; show(file.files[0]); } });
    document.getElementById('upForm').addEventListener('submit', e => {
        const f = file.files[0];
        if (!document.getElementById('docType').value) { e.preventDefault(); e.stopImmediatePropagation(); Swal.fire({ icon: 'info', title: 'Belge türünü seçin', confirmButtonColor: '#2F54EB' }); return; }
        if (!f) { e.preventDefault(); e.stopImmediatePropagation(); Swal.fire({ icon: 'info', title: 'Bir dosya seçin', confirmButtonColor: '#2F54EB' }); return; }
        if (f.size > 5 * 1024 * 1024) { e.preventDefault(); e.stopImmediatePropagation(); Swal.fire({ icon: 'warning', title: 'Dosya çok büyük', text: 'En fazla 5 MB yükleyebilirsiniz.', confirmButtonColor: '#2F54EB' }); }
    });
    document.querySelectorAll('.js-pick').forEach(b => b.addEventListener('click', () => {
        document.getElementById('docType').value = b.dataset.v;
        document.getElementById('upForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(() => file.click(), 350);
    }));
    const seg = document.getElementById('seg');
    seg.querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
        seg.querySelectorAll('button').forEach(x => x.classList.toggle('active', x === b));
        let n = 0;
        document.querySelectorAll('#docList .doc').forEach(d => { const ok = !b.dataset.v || d.dataset.status === b.dataset.v; d.style.display = ok ? '' : 'none'; if (ok) n++; });
        document.getElementById('segEmpty').classList.toggle('d-none', n > 0 || !document.querySelector('#docList .doc'));
    }));
})();
</script>
</body>
</html>
