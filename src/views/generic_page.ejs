<!DOCTYPE html>
<html lang="tr">
<head>
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Yardım' %> | BERLINER Aday Portalı</title>
    <%- include('partials/cand_head') %>
    <style>
        .accordion-item { border: 1px solid var(--line); border-radius: 12px !important; overflow: hidden; margin-bottom: 8px; }
        .accordion-button { font-weight: 650; color: var(--ink); padding: 16px 18px; }
        .accordion-button:not(.collapsed) { background: var(--brand-50); color: var(--brand); box-shadow: none; }
        .accordion-button:focus { box-shadow: 0 0 0 3px rgba(47,84,235,.12); }
        .accordion-body { color: var(--ink-2); line-height: 1.6; }
    </style>
</head>
<body>
<%
    const faqs = [
        ['Başvurum hangi aşamada?', 'Ana Sayfa ve Süreç Takibi sayfalarında güncel aşamanı, tamamlanan adımları ve sıradaki adımı görebilirsin. Aşamalar danışmanın tarafından güncellenir.'],
        ['Hangi belgeleri yüklemem gerekiyor?', 'Belgelerim sayfasındaki "Temel Belgeler" listesi zorunlu belgeleri gösterir: pasaport, kimlik, ehliyet, biyometrik fotoğraf, adli sicil, diploma, SGK hizmet dökümü ve sağlık raporu. Danışmanın ek belge isteyebilir.'],
        ['Belgem reddedildi, ne yapmalıyım?', 'Reddedilen belgeyi Belgelerim sayfasından silip doğru ve okunaklı halini yeniden yükle. Gerekirse danışmanından mesaj ya da randevu ile bilgi iste.'],
        ['Hangi dosya türlerini yükleyebilirim?', 'PDF, JPG ve PNG dosyaları (en fazla 5 MB). Telefonundan belgenin fotoğrafını çekip doğrudan yükleyebilirsin; fotoğrafın net ve tüm köşelerin görünür olmasına dikkat et.'],
        ['Danışmanımla nasıl iletişim kurarım?', 'Randevular sayfasından görüşme talebi oluşturabilirsin. Danışmanından gelen mesajlar Mesajlar sayfasında ve üstteki zil simgesinde görünür.'],
        ['Giriş yapamıyorum.', 'Ad, soyad ve pasaport numaranı başvurudaki haliyle yazdığından emin ol. Birden fazla adın varsa hepsini yaz. Sorun devam ederse danışmanınla iletişime geç.'],
        ['İletişim bilgilerimi nasıl güncellerim?', 'Profilim sayfasından e-posta, telefon, meslek, konum ve hedef şehir bilgilerini güncelleyebilirsin.']
    ];
%>
<%- include('partials/cand_shell_start', { page: 'help', title: 'Yardım Merkezi', subtitle: 'Sık sorulan sorular ve destek' }) %>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="c-card">
            <div class="c-card-h"><div class="c-ic t-brand"><i class="fas fa-circle-question"></i></div><div><h2>Sık Sorulan Sorular</h2></div></div>
            <div class="c-card-b">
                <div class="accordion" id="faq">
                    <% faqs.forEach(([q, a], i) => { %>
                    <div class="accordion-item">
                        <h3 class="accordion-header"><button class="accordion-button <%= i ? 'collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#f<%= i %>"><%= q %></button></h3>
                        <div id="f<%= i %>" class="accordion-collapse collapse <%= i ? '' : 'show' %>" data-bs-parent="#faq"><div class="accordion-body"><%= a %></div></div>
                    </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="hero mb-3">
            <h3 class="fs-5 fw-bold text-white position-relative" style="z-index:1">Hâlâ yardıma mı ihtiyacın var?</h3>
            <p class="small position-relative" style="z-index:1;color:rgba(255,255,255,.75)">Danışmanınla birebir görüşmek için randevu oluştur.</p>
            <a href="/appointments" class="btn btn-sm position-relative" style="z-index:1;background:#fff;color:var(--ink)"><i class="fas fa-calendar-plus me-1"></i> Randevu al</a>
        </div>
        <div class="c-card c-card-b">
            <h3 class="fs-6 fw-bold mb-3">Hızlı bağlantılar</h3>
            <div class="d-flex flex-column gap-2">
                <a href="/documents" class="btn btn-soft text-start"><i class="fas fa-folder-open me-2 muted"></i>Belgelerim</a>
                <a href="/application-form" class="btn btn-soft text-start"><i class="fas fa-file-signature me-2 muted"></i>Başvuru Formu</a>
                <a href="/100_26_LOJISTIK_BILGILENDIRME.pdf" download class="btn btn-soft text-start"><i class="fas fa-file-pdf me-2 muted"></i>Lojistik Kılavuzu (PDF)</a>
            </div>
        </div>
    </div>
</div>

<%- include('partials/cand_shell_end', { page: 'help' }) %>
</body>
</html>
