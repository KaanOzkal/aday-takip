<!DOCTYPE html>
<html lang="tr">
<head>
    <title><%= categoryTitle %> | BERLINER Aday Portalı</title>
    <%- include('partials/cand_head') %>
    <style>
        .word-card {
            background: white;
            border: 1px solid #f1f5f9;
            border-radius: 20px;
            padding: 1.5rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .word-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
            border-color: #e2e8f0;
        }
        .word-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 4px;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
        }
        .german-word {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.25rem;
        }
        .turkish-word {
            color: #64748b;
            font-weight: 500;
            font-size: 1rem;
        }
        .example-box {
            background: #f8fafc;
            border-radius: 12px;
            padding: 1rem;
            margin-top: auto; /* Kartın en altına iter */
            border: 1px solid #f1f5f9;
        }
        .audio-btn {
            width: 36px; height: 36px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            background: #f1f5f9;
            color: #3b82f6;
            transition: 0.2s;
            cursor: pointer;
        }
        .audio-btn:hover { background: #e0f2fe; }
    </style>
</head>
<body>
<%- include('partials/cand_shell_start', { page: 'german', title: categoryTitle, subtitle: 'Kategoriye göre kelimeler' }) %>
<div class="d-flex align-items-center justify-content-between mb-5">
                    <div class="d-flex align-items-center gap-3">
                        <a href="/german" class="btn btn-white border shadow-sm rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                            <i class="fas fa-arrow-left text-dark"></i>
                        </a>
                        <div>
                            <h2 class="fw-bold text-dark mb-0"><%= categoryTitle %></h2>
                            <p class="text-muted mb-0 small">Bu kategorideki kelime kartları</p>
                        </div>
                    </div>
                    
                    <div class="d-none d-md-flex align-items-center gap-2 bg-white px-3 py-2 rounded-pill shadow-sm border">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <%= user.firstName.charAt(0) %><%= user.lastName.charAt(0) %>
                        </div>
                        <span class="fw-bold small"><%= user.firstName %> <%= user.lastName %></span>
                    </div>
                </div>

                <% if(words.length > 0) { %>
                    <div class="row g-4">
                        <% words.forEach(word => { %>
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="word-card shadow-sm">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <div class="german-word"><%= word.german %></div>
                                            <div class="turkish-word"><%= word.turkish %></div>
                                        </div>
                                    </div>

                                    <% if(word.exampleGerman) { %>
                                        <div class="example-box">
                                            <div class="d-flex gap-2">
                                                <i class="fas fa-quote-left text-primary opacity-25"></i>
                                                <div>
                                                    <p class="mb-1 text-dark fw-medium small"><%= word.exampleGerman %></p>
                                                    <p class="mb-0 text-muted small" style="font-size: 0.85rem;"><%= word.exampleTurkish %></p>
                                                </div>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <div class="example-box text-center text-muted small">
                                            Örnek cümle bulunmuyor.
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <div class="bg-white p-5 rounded-circle d-inline-block shadow-sm mb-3">
                            <i class="fas fa-layer-group fa-3x text-muted opacity-25"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Henüz kelime yok</h5>
                        <p class="text-muted">Bu kategoriye henüz içerik eklenmemiş.</p>
                        <a href="/german" class="btn btn-primary rounded-pill px-4 mt-2">Geri Dön</a>
                    </div>
                <% } %>
<%- include('partials/cand_shell_end', { page: 'german' }) %>

</body>
</html>
