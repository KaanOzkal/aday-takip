<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Randevular | BERLINER Aday Portalı</title>
    <%- include('partials/cand_head') %>
    <style>
        .type-opt input { position: absolute; opacity: 0; }
        .type-opt label { display: flex; align-items: center; gap: 10px; padding: 11px 12px; border: 1px solid var(--line); border-radius: 12px; cursor: pointer; font-weight: 600; font-size: 13.5px; background: #fff; height: 100%; }
        .type-opt input:checked + label { border-color: var(--brand); background: var(--brand-50); color: var(--brand); box-shadow: 0 0 0 3px rgba(47,84,235,.12); }
        .slots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
        .slots input { position: absolute; opacity: 0; }
        .slots label { display: block; text-align: center; padding: 8px 0; border: 1px solid var(--line); border-radius: 10px; font-weight: 600; font-size: 13px; cursor: pointer; background: #fff; }
        .slots input:checked + label { background: var(--brand); border-color: var(--brand); color: #fff; }
        .ap { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border-bottom: 1px solid #F0F2F5; }
        .ap:last-child { border-bottom: 0; }
        .cal { width: 56px; border-radius: 12px; overflow: hidden; text-align: center; border: 1px solid var(--line); flex-shrink: 0; background: #fff; }
        .cal .m { background: var(--brand); color: #fff; font-size: 10.5px; font-weight: 700; text-transform: uppercase; padding: 2px 0; }
        .cal .dd { font-size: 20px; font-weight: 800; color: var(--ink); line-height: 1.5; }
        .ap.past { opacity: .6; }
    </style>
</head>
<body>
<%
    const list = appointments || [];
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const isPast = (a) => { const d = new Date(a.date + 'T00:00:00'); return !isNaN(d) && d < today; };
    const upcoming = list.filter(a => !isPast(a) && a.status !== 'Reddedildi');
    const others = list.filter(a => isPast(a) || a.status === 'Reddedildi');
    const tone = (s) => s === 'Onaylandı' ? 't-ok' : s === 'Reddedildi' ? 't-bad' : 't-warn';
    const label = (s) => s === 'Beklemede' ? 'Onay bekliyor' : s;
    const minDate = new Date().toISOString().slice(0, 10);
    const types = [['Genel Görüşme', 'fa-comments'], ['Evrak Teslimi', 'fa-folder-open'], ['Vize Hazırlığı', 'fa-passport'], ['Acil Destek', 'fa-life-ring']];
    const slots = ['09:00', '10:00', '11:00', '12:00', '13:30', '14:30', '15:30', '16:30'];
%>
<%- include('partials/cand_shell_start', { page: 'appointments', title: 'Randevular', subtitle: 'Danışmanınla görüşmek için randevu talep et' }) %>

<div class="row g-3">
    <div class="col-lg-5">
        <form class="c-card" action="/appointments/create" method="POST" id="apForm">
            <div class="c-card-h"><div class="c-ic t-brand"><i class="fas fa-calendar-plus"></i></div><div><h2>Yeni Randevu Talebi</h2><p class="sub">Talebin danışmanın onayına gönderilir.</p></div></div>
            <div class="c-card-b">
                <label class="form-label">Görüşme konusu</label>
                <div class="row g-2 mb-3">
                    <% types.forEach(([t, i], k) => { %>
                    <div class="col-6 type-opt position-relative">
                        <input type="radio" name="type" id="ty<%= k %>" value="<%= t %>" <%= k === 0 ? 'checked' : '' %>>
                        <label for="ty<%= k %>"><i class="fas <%= i %>"></i><%= t %></label>
                    </div>
                    <% }) %>
                </div>
                <label class="form-label" for="dt">Tarih</label>
                <input type="date" name="date" id="dt" class="form-control mb-3" min="<%= minDate %>" required>
                <label class="form-label">Saat</label>
                <div class="slots mb-2">
                    <% slots.forEach((s, k) => { %>
                    <div class="position-relative"><input type="radio" name="time" id="sl<%= k %>" value="<%= s %>" <%= k === 1 ? 'checked' : '' %>><label for="sl<%= k %>"><%= s %></label></div>
                    <% }) %>
                </div>
                <div class="form-text mb-3">Hafta içi 09:00 – 17:00 arası. Tarih Türkiye saatine göredir.</div>
                <button class="btn btn-brand w-100"><i class="fas fa-paper-plane me-1"></i> Talep Gönder</button>
            </div>
        </form>
    </div>

    <div class="col-lg-7">
        <div class="c-card mb-3">
            <div class="c-card-h"><div><h2>Yaklaşan Randevular</h2><p class="sub"><%= upcoming.length %> randevu</p></div></div>
            <% if (!upcoming.length) { %>
                <div class="empty"><div class="c-ic t-gray"><i class="far fa-calendar"></i></div><div class="fw-650 text-dark">Yaklaşan randevun yok</div><div class="small">Soldaki formdan yeni bir talep oluşturabilirsin.</div></div>
            <% } %>
            <% upcoming.forEach(a => { const d = new Date(a.date + 'T00:00:00'); %>
            <div class="ap">
                <div class="cal"><div class="m"><%= isNaN(d) ? '' : d.toLocaleDateString('tr-TR', { month: 'short' }) %></div><div class="dd"><%= isNaN(d) ? '?' : d.getDate() %></div></div>
                <div class="flex-grow-1" style="min-width:0">
                    <div class="fw-650 text-dark"><%= a.type %></div>
                    <div class="small muted"><i class="far fa-clock me-1"></i><%= a.time %> · <%= isNaN(d) ? a.date : d.toLocaleDateString('tr-TR', { weekday: 'long' }) %></div>
                </div>
                <span class="pill <%= tone(a.status) %>"><span class="d"></span><%= label(a.status) %></span>
                <% if (a.status === 'Beklemede') { %>
                <form action="/appointments/<%= a._id %>/cancel" method="POST" class="m-0" data-confirm="Bu randevu talebi iptal edilecek.">
                    <button class="btn btn-soft btn-sm" title="İptal et" data-no-busy><i class="fas fa-xmark"></i></button>
                </form>
                <% } %>
            </div>
            <% }) %>
        </div>
        <% if (others.length) { %>
        <div class="c-card">
            <div class="c-card-h"><h2>Geçmiş</h2></div>
            <% others.forEach(a => { const d = new Date(a.date + 'T00:00:00'); %>
            <div class="ap past">
                <div class="cal"><div class="m" style="background:#98A2B3"><%= isNaN(d) ? '' : d.toLocaleDateString('tr-TR', { month: 'short' }) %></div><div class="dd"><%= isNaN(d) ? '?' : d.getDate() %></div></div>
                <div class="flex-grow-1"><div class="fw-650 text-dark"><%= a.type %></div><div class="small muted"><%= a.time %></div></div>
                <span class="pill <%= tone(a.status) %>"><span class="d"></span><%= label(a.status) %></span>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>
</div>

<%- include('partials/cand_shell_end', { page: 'appointments' }) %>
<script>
cNotify({
    ok: { success: 'Randevu talebin alındı. Onaylandığında burada göreceksin.', cancelled: 'Randevu talebi iptal edildi.' },
    err: { past_date: 'Geçmiş bir tarih seçemezsiniz.', missing: 'Lütfen tarih ve saat seçin.', too_many: 'Aynı anda en fazla 3 bekleyen randevu talebiniz olabilir.', cannot_cancel: 'Yalnızca onay bekleyen randevular iptal edilebilir.' }
});
document.getElementById('dt').addEventListener('change', function () {
    const d = new Date(this.value + 'T00:00:00').getDay();
    if (d === 0 || d === 6) Swal.fire({ icon: 'info', title: 'Hafta sonu seçtin', text: 'Danışmanlarımız genellikle hafta içi çalışır. Talebin yine de iletilecek.', confirmButtonColor: '#2F54EB' });
});
</script>
</body>
</html>
