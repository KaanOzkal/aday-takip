<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Mesajlar | BERLINER Aday Portalı</title>
    <%- include('partials/cand_head') %>
    <style>
        .thread { padding: 8px 0; }
        .day { text-align: center; margin: 18px 0 10px; }
        .day span { background: #F2F4F7; color: #667085; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 99px; }
        .bubble-row { display: flex; gap: 12px; padding: 6px 20px; align-items: flex-end; }
        .bubble-row.me { flex-direction: row-reverse; }
        .bubble { max-width: 640px; background: #fff; border: 1px solid var(--line); border-radius: 16px 16px 16px 4px; padding: 12px 14px; box-shadow: 0 1px 2px rgba(16,24,40,.04); }
        .bubble-row.me .bubble { background: var(--brand); color: #fff; border-color: var(--brand); border-radius: 16px 16px 4px 16px; }
        .bubble .txt { white-space: pre-wrap; word-break: break-word; line-height: 1.55; }
        .bubble .meta { font-size: 11.5px; color: var(--muted); margin-top: 6px; display: flex; gap: 8px; align-items: center; }
        .bubble.new { border-color: #C7D2FE; box-shadow: 0 0 0 3px rgba(47,84,235,.08); }
        .av-sm { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--navy); color: #fff; font-size: 13px; flex-shrink: 0; }
        .search-ic { position: relative; } .search-ic i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #98A2B3; } .search-ic input { padding-left: 36px; }
    </style>
</head>
<body>
<%
    const nids = (typeof newIds !== 'undefined' && newIds) ? newIds : [];
    const ordered = messages.slice().sort((a, b) => new Date(a.date) - new Date(b.date));
    const dayKey = d => new Date(d).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
    let lastDay = null;
%>
<%- include('partials/cand_shell_start', { page: 'messages', title: 'Mesajlar', subtitle: 'Danışmanından gelen bildirim ve duyurular' }) %>

<div class="c-card">
    <div class="c-card-h">
        <div class="av-sm"><i class="fas fa-user-tie"></i></div>
        <div class="flex-grow-1"><h2>BERLINER Danışman Ekibi</h2><p class="sub"><%= messages.length %> mesaj<% if (nids.length) { %> · <strong style="color:var(--brand)"><%= nids.length %> yeni</strong><% } %></p></div>
        <% if (messages.length > 3) { %><div class="search-ic" style="width:220px"><i class="fas fa-magnifying-glass"></i><input type="search" id="q" class="form-control form-control-sm" placeholder="Mesajlarda ara"></div><% } %>
    </div>
    <div class="thread" id="thread">
        <% if (!messages.length) { %>
            <div class="empty"><div class="c-ic t-gray"><i class="far fa-envelope-open"></i></div><div class="fw-650 text-dark">Henüz mesajın yok</div><div class="small">Danışmanın sana yazdığında mesajlar burada görünecek.</div></div>
        <% } %>
        <% ordered.forEach(m => { const k = dayKey(m.date); const mine = m.sender && m.sender !== 'Admin'; %>
            <% if (k !== lastDay) { lastDay = k; %><div class="day"><span><%= k %></span></div><% } %>
            <div class="bubble-row <%= mine ? 'me' : '' %>" data-text="<%= (m.content || '').toLocaleLowerCase('tr-TR') %>">
                <% if (!mine) { %><div class="av-sm"><i class="fas fa-user-tie"></i></div><% } %>
                <div class="bubble <%= nids.includes(String(m._id)) ? 'new' : '' %>">
                    <div class="txt"><%= m.content %></div>
                    <div class="meta"><span><%= new Date(m.date).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) %></span>
                        <% if (nids.includes(String(m._id))) { %><span class="pill t-brand" style="font-size:10.5px;padding:1px 7px">Yeni</span><% } %></div>
                </div>
            </div>
        <% }) %>
        <div class="empty d-none" id="noMatch">Aramanızla eşleşen mesaj yok.</div>
    </div>
    <div class="px-4 py-3 d-flex align-items-center gap-3 flex-wrap" style="border-top:1px solid var(--line);background:#FAFBFC;border-radius:0 0 var(--radius) var(--radius)">
        <i class="fas fa-circle-info muted"></i>
        <div class="small muted flex-grow-1">Bir sorunuz mu var? Danışmanınızla görüşmek için randevu oluşturabilirsiniz.</div>
        <a href="/appointments" class="btn btn-brand btn-sm"><i class="fas fa-calendar-plus me-1"></i> Randevu al</a>
    </div>
</div>

<%- include('partials/cand_shell_end', { page: 'messages' }) %>
<script>
(function () {
    const n = document.querySelector('.bubble.new') || document.querySelector('#thread .bubble-row:last-of-type');
    if (n && document.querySelectorAll('.bubble-row').length > 4) n.scrollIntoView({ block: 'center' });
    const q = document.getElementById('q');
    q && q.addEventListener('input', () => {
        const v = q.value.trim().toLocaleLowerCase('tr-TR'); let c = 0;
        document.querySelectorAll('.bubble-row').forEach(r => { const ok = !v || r.dataset.text.includes(v); r.style.display = ok ? '' : 'none'; if (ok) c++; });
        document.querySelectorAll('.day').forEach(d => d.style.display = v ? 'none' : '');
        document.getElementById('noMatch').classList.toggle('d-none', c > 0);
    });
})();
</script>
</body>
</html>
