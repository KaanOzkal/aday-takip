<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Personel Girişi | BERLINER</title>
    <meta name="robots" content="noindex">
    <%- include('partials/cand_head') %>
    <style>
        body { min-height: 100vh; display: grid; place-items: center; padding: 24px 16px;
            background: radial-gradient(1000px 500px at 85% -10%, rgba(212,17,27,.35), transparent 60%), radial-gradient(800px 400px at -10% 110%, rgba(255,206,0,.12), transparent 60%), #0B1220; }
        .box { width: 100%; max-width: 420px; background: #fff; border-radius: 22px; padding: 32px 28px; box-shadow: 0 30px 60px rgba(0,0,0,.35); }
        .mk { width: 46px; height: 46px; border-radius: 14px; background: linear-gradient(135deg, #E5333C, #B00E16); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: 18px; }
        .tag { font-size: 11px; font-weight: 700; letter-spacing: .8px; background: #FFF8DB; color: #8A6A00; border: 1px solid #FCE58A; padding: 2px 9px; border-radius: 99px; text-transform: uppercase; }
        .input-ic { position: relative; } .input-ic i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #98A2B3; } .input-ic .form-control { padding-left: 40px; height: 48px; }
        .toggle-pw { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); border: 0; background: none; color: #98A2B3; padding: 6px 8px; }
        .note { display: flex; gap: 8px; align-items: flex-start; padding: 12px; border-radius: 12px; font-size: 13.5px; margin-bottom: 16px; }
    </style>
</head>
<body>
<%
    const reasons = { login_required: ['Devam etmek için giriş yapın.', 'info'], account_passive: ['Hesabınız pasife alındı. Yöneticinizle iletişime geçin.', 'bad'], account_disabled: ['Hesabınız devre dışı bırakıldı.', 'bad'], session_expired: ['Oturumunuz sonlandırıldı (şifre değişikliği veya yönetici işlemi). Lütfen tekrar giriş yapın.', 'warn'] };
    const statuses = { logged_out: 'Güvenli şekilde çıkış yaptınız.', password_set: 'Şifreniz belirlendi. Şimdi giriş yapabilirsiniz.' };
    const r = reasons[reason];
%>
<div class="box fade-up">
    <div class="d-flex align-items-center gap-3 mb-4">
        <img src="/img/berliner-logo.png" alt="BERLINER" style="width:56px;height:56px">
        <div><div class="fw-bold text-dark" style="letter-spacing:.6px">BERLINER</div><span class="tag">Personel Paneli</span></div>
    </div>
    <h1 class="fs-4 fw-bold mb-1">Personel Girişi</h1>
    <p class="muted mb-4" style="font-size:14px">Size atanan görevleri görüntülemek için giriş yapın.</p>
    <% if (error) { %><div class="note" style="background:var(--bad-50);color:#B42318;border:1px solid #FECDCA"><i class="fas fa-circle-exclamation mt-1"></i><div><%= error %></div></div><% } %>
    <% if (!error && r) { %><div class="note" style="background:<%= r[1] === 'bad' ? 'var(--bad-50)' : r[1] === 'warn' ? 'var(--warn-50)' : 'var(--brand-50)' %>;color:<%= r[1] === 'bad' ? '#B42318' : r[1] === 'warn' ? '#93370D' : '#B00E16' %>"><i class="fas fa-circle-info mt-1"></i><div><%= r[0] %></div></div><% } %>
    <% if (!error && statuses[status]) { %><div class="note" style="background:var(--ok-50);color:#027A48;border:1px solid #A6F4C5"><i class="fas fa-circle-check mt-1"></i><div><%= statuses[status] %></div></div><% } %>
    <form action="/personel/giris" method="POST" id="f" novalidate>
        <div class="mb-3"><label class="form-label" for="u">Kullanıcı adı</label>
            <div class="input-ic"><i class="far fa-user"></i><input id="u" name="username" class="form-control" value="<%= username %>" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus></div></div>
        <div class="mb-4"><label class="form-label" for="p">Şifre</label>
            <div class="input-ic"><i class="fas fa-lock"></i><input id="p" type="password" name="password" class="form-control" autocomplete="current-password" required><button type="button" class="toggle-pw" aria-label="Şifreyi göster" onclick="const i=document.getElementById('p');i.type=i.type==='password'?'text':'password';this.innerHTML=i.type==='password'?'<i class=\'far fa-eye\'></i>':'<i class=\'far fa-eye-slash\'></i>'"><i class="far fa-eye"></i></button></div></div>
        <button class="btn btn-brand w-100" style="height:50px;font-size:15px">Giriş Yap <i class="fas fa-arrow-right ms-1"></i></button>
    </form>
    <div class="text-center small muted mt-4">Şifrenizi mi unuttunuz? Yöneticinizden sıfırlama bağlantısı isteyin.</div>
</div>
<script>
document.getElementById('f').addEventListener('submit', function (e) {
    const empty = [...this.querySelectorAll('[required]')].find(i => !i.value.trim());
    if (empty) { e.preventDefault(); empty.classList.add('is-invalid'); empty.focus(); return; }
    const b = this.querySelector('button.btn'); b.disabled = true; b.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Giriş yapılıyor…';
});
</script>
</body>
</html>
