<!DOCTYPE html>
<html lang="tr">
<head>
    <title>İşlem Geçmişi | BERLINER Yönetim</title>
    <%- include('partials/admin_head') %>
</head>
<body>
<%
    const tone = (a) => a.startsWith('security') || a.endsWith('login_failed') ? 't-bad' : a.startsWith('staff') ? 't-info' : a.startsWith('workorder') ? 't-brand' : 't-gray';
    const actorLbl = { admin: 'Yönetici', staff: 'Personel', system: 'Sistem', anonymous: 'Ziyaretçi' };
%>
<div class="app">
    <%- include('partials/admin_sidebar', { active: 'audit', onMain: false }) %>
    <div class="main">
        <header class="topbar">
            <button class="btn btn-soft btn-icon menu-toggle" aria-label="Menü"><i class="fas fa-bars"></i></button>
            <div><div class="crumb">Güvenlik</div><h1>İşlem Geçmişi</h1></div>
        </header>
        <main class="content">
            <div class="card-x">
                <form class="card-h" method="GET">
                    <div><h2>Audit Log</h2><p class="sub">Personel, iş emri ve güvenlik olaylarının kaydı (son 500)</p></div>
                    <div class="ms-auto d-flex gap-2 flex-wrap">
                        <div class="search" style="width:220px"><i class="fas fa-magnifying-glass"></i><input type="search" name="q" value="<%= f.q %>" class="form-control form-control-sm" placeholder="Kişi, işlem, IP…"></div>
                        <select name="actor" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                            <option value="">Tüm kullanıcılar</option><% Object.entries(actorLbl).forEach(([k, v]) => { %><option value="<%= k %>" <%= f.actor === k ? 'selected' : '' %>><%= v %></option><% }) %>
                        </select>
                        <select name="action" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                            <option value="">Tüm işlemler</option>
                            <option value="workorder" <%= f.action === 'workorder' ? 'selected' : '' %>>İş emirleri</option>
                            <option value="staff" <%= f.action === 'staff' ? 'selected' : '' %>>Personel hesapları</option>
                            <option value="security" <%= f.action === 'security' ? 'selected' : '' %>>Güvenlik uyarıları</option>
                            <option value="candidate" <%= f.action === 'candidate' ? 'selected' : '' %>>Aday verisi erişimi</option>
                        </select>
                        <button class="btn btn-soft btn-sm">Filtrele</button>
                    </div>
                </form>
                <div class="table-responsive">
                    <table class="table table-x">
                        <thead><tr><th>Zaman</th><th>Kullanıcı</th><th>İşlem</th><th>Açıklama</th><th class="d-none d-lg-table-cell">IP</th></tr></thead>
                        <tbody>
                        <% list.forEach(l => { %>
                            <tr>
                                <td class="text-nowrap small"><%= fmtDT(l.createdAt) %></td>
                                <td><div class="fw-650"><%= l.actorName || '—' %></div><div class="muted small"><%= actorLbl[l.actorType] || l.actorType %></div></td>
                                <td><span class="pill <%= tone(l.action || '') %> font-monospace" style="font-size:11px"><%= l.action %></span></td>
                                <td class="small" style="max-width:420px"><%= l.summary %></td>
                                <td class="d-none d-lg-table-cell muted small font-monospace"><%= l.ip %></td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                    <% if (!list.length) { %><div class="empty"><i class="fas fa-shield-halved"></i>Kayıt bulunamadı.</div><% } %>
                </div>
            </div>
        </main>
    </div>
</div>
<%- include('partials/admin_scripts') %>
</body>
</html>
