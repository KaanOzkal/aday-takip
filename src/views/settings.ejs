<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Ayarlar | BERLINER Aday Portalı</title>
    <%- include('partials/cand_head') %>
    <style>
        .pref { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border-bottom: 1px solid #F0F2F5; cursor: pointer; margin: 0; }
        .pref:last-child { border-bottom: 0; }
        .pref .form-check-input { width: 2.6em; height: 1.4em; margin: 0; cursor: pointer; }
    </style>
</head>
<body>
<% const pr = user.preferences || {}; const on = (k, d) => (pr[k] === undefined ? d : pr[k]); %>
<%- include('partials/cand_shell_start', { page: 'settings', title: 'Ayarlar', subtitle: 'Bildirim tercihlerini ve hesabını yönet' }) %>

<div class="row g-3">
    <div class="col-lg-7">
        <form class="c-card" action="/settings/update" method="POST">
            <div class="c-card-h"><div class="c-ic t-brand"><i class="far fa-bell"></i></div><div><h2>Bildirim Tercihleri</h2><p class="sub">Danışmanın seninle hangi kanallardan iletişim kurabilir?</p></div></div>
            <label class="pref"><div class="c-ic t-gray"><i class="far fa-envelope"></i></div><div class="flex-grow-1"><div class="fw-650 text-dark">E-posta bildirimleri</div><div class="small muted">Önemli güncellemeleri e-posta ile al<%= user.email ? ' (' + user.email + ')' : '' %>.</div></div><input class="form-check-input" type="checkbox" role="switch" name="emailNotifications" <%= on('emailNotifications', true) ? 'checked' : '' %>></label>
            <label class="pref"><div class="c-ic t-gray"><i class="fas fa-comment-sms"></i></div><div class="flex-grow-1"><div class="fw-650 text-dark">SMS bildirimleri</div><div class="small muted">Randevu hatırlatmalarını SMS ile al.</div></div><input class="form-check-input" type="checkbox" role="switch" name="smsNotifications" <%= on('smsNotifications', true) ? 'checked' : '' %>></label>
            <label class="pref"><div class="c-ic t-gray"><i class="fab fa-whatsapp"></i></div><div class="flex-grow-1"><div class="fw-650 text-dark">WhatsApp duyuruları</div><div class="small muted">Duyurular WhatsApp üzerinden de gelsin.</div></div><input class="form-check-input" type="checkbox" role="switch" name="whatsappNotifications" <%= on('whatsappNotifications', false) ? 'checked' : '' %>></label>
            <div class="d-flex justify-content-end px-4 py-3" style="border-top:1px solid var(--line)"><button class="btn btn-brand"><i class="fas fa-check me-1"></i> Tercihleri Kaydet</button></div>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="c-card mb-3">
            <div class="c-card-h"><div class="c-ic t-info"><i class="fas fa-shield-halved"></i></div><div><h2>Giriş Bilgileri</h2><p class="sub">Portala ad, soyad ve pasaport numaranla giriş yaparsın.</p></div></div>
            <div class="c-card-b small">
                <div class="d-flex justify-content-between py-2" style="border-bottom:1px dashed var(--line)"><span class="muted">Ad Soyad</span><b class="text-dark"><%= user.firstName %> <%= user.lastName %></b></div>
                <div class="d-flex justify-content-between py-2"><span class="muted">Pasaport No</span><b class="text-dark font-monospace"><%= user.passportNo %></b></div>
                <div class="muted mt-2">Bu bilgilerde hata varsa danışmanınla iletişime geç.</div>
            </div>
        </div>
        <div class="c-card c-card-b d-flex align-items-center gap-3">
            <div class="c-ic t-bad"><i class="fas fa-arrow-right-from-bracket"></i></div>
            <div class="flex-grow-1"><div class="fw-650 text-dark">Oturumu kapat</div><div class="small muted">Ortak bir cihaz kullanıyorsan çıkış yapmayı unutma.</div></div>
            <a href="/logout" class="btn btn-soft" style="color:var(--bad)">Çıkış</a>
        </div>
    </div>
</div>

<%- include('partials/cand_shell_end', { page: 'settings' }) %>
<script>cNotify({ ok: { saved: 'Tercihlerin kaydedildi.' } });</script>
</body>
</html>
