<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Profilim | BERLINER Aday Portalı</title>
    <%- include('partials/cand_head') %>
    <style>
        .pf-cover { height: 96px; border-radius: var(--radius) var(--radius) 0 0; background: linear-gradient(135deg, #0B1220, #2343C9); }
        .pf-av { width: 88px; height: 88px; border-radius: 50%; background: var(--brand-50); color: var(--brand); border: 4px solid #fff; display: grid; place-items: center; font-weight: 800; font-size: 28px; margin: -44px auto 10px; box-shadow: 0 4px 12px rgba(16,24,40,.1); }
        .kv { display: flex; justify-content: space-between; gap: 12px; padding: 11px 0; border-bottom: 1px dashed var(--line); font-size: 13.5px; }
        .kv:last-child { border-bottom: 0; }
        .kv span:first-child { color: var(--muted); }
        .kv span:last-child { font-weight: 600; color: var(--ink); text-align: right; }
        .city { position: relative; }
        .city input { position: absolute; opacity: 0; }
        .city label { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; cursor: pointer; font-weight: 600; background: #fff; transition: all .15s; }
        .city label:hover { border-color: #C7D2FE; }
        .city input:checked + label { border-color: var(--brand); background: var(--brand-50); color: var(--brand); box-shadow: 0 0 0 3px rgba(47,84,235,.12); }
        .city input:focus-visible + label { outline: 2px solid var(--brand); }
    </style>
</head>
<body>
<%
    const ini = ((user.firstName || '?').charAt(0) + (user.lastName || '').charAt(0)).toLocaleUpperCase('tr-TR');
    const cities = (typeof states !== 'undefined' && states) ? states : ['Berlin', 'Hamburg', 'Kiel', 'Hannover', 'Dortmund', 'Gelsenkirchen'];
    const phone = user.phone || user.phoneNumber || '';
    const missing = !user.email || !phone;
%>
<%- include('partials/cand_shell_start', { page: 'profile', title: 'Profilim', subtitle: 'Kişisel bilgilerini ve hedef şehrini yönet' }) %>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="c-card">
            <div class="pf-cover"></div>
            <div class="px-4 pb-4 text-center">
                <div class="pf-av"><%= ini %></div>
                <h2 class="fs-5 fw-bold mb-1"><%= user.firstName %> <%= user.lastName %></h2>
                <div class="muted mb-3"><%= user.job || 'Meslek belirtilmedi' %></div>
                <span class="pill t-brand"><span class="d"></span><%= user.currentStage %></span>
                <div class="text-start mt-4">
                    <div class="kv"><span>Pasaport No</span><span class="font-monospace"><%= user.passportNo || '—' %></span></div>
                    <div class="kv"><span>Hedef şehir</span><span><%= user.targetState && user.targetState !== 'Belirtilmedi' ? user.targetState : 'Seçilmedi' %></span></div>
                    <div class="kv"><span>İşveren</span><span><%= user.company && user.company !== 'Atanmadı' ? user.company : 'Eşleşme bekleniyor' %></span></div>
                    <div class="kv"><span>Profil puanı</span><span><%= user.score %> / 100</span></div>
                    <div class="kv"><span>Kayıt tarihi</span><span><%= new Date(user.applicationDate).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }) %></span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <% if (missing) { %>
        <div class="d-flex gap-3 align-items-center p-3 mb-3" style="background:var(--warn-50);border:1px solid #FEDF89;border-radius:14px;color:#93370D">
            <i class="fas fa-circle-info fa-lg"></i>
            <div><strong>İletişim bilgilerin eksik.</strong> Danışmanının sana ulaşabilmesi için e-posta ve telefon numaranı ekle.</div>
        </div>
        <% } %>
        <form class="c-card" action="/profile/update" method="POST">
            <div class="c-card-h"><div><h2>Bilgileri Düzenle</h2><p class="sub">Ad, soyad ve pasaport bilgisi yalnızca danışmanın tarafından değiştirilebilir.</p></div></div>
            <div class="c-card-b">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Ad</label><input class="form-control" value="<%= user.firstName %>" disabled></div>
                    <div class="col-md-6"><label class="form-label">Soyad</label><input class="form-control" value="<%= user.lastName %>" disabled></div>
                    <div class="col-md-6"><label class="form-label" for="em">E-posta adresi *</label><input id="em" type="email" name="email" class="form-control" value="<%= user.email || '' %>" placeholder="ornek@mail.com" required autocomplete="email"></div>
                    <div class="col-md-6"><label class="form-label" for="ph">Telefon numarası *</label><input id="ph" type="tel" name="phone" class="form-control" value="<%= phone %>" placeholder="+90 5xx xxx xx xx" required autocomplete="tel"></div>
                    <div class="col-md-6"><label class="form-label" for="jb">Meslek / Uzmanlık</label><input id="jb" name="job" class="form-control" value="<%= user.job || '' %>" placeholder="Örn: Tır Şoförü"></div>
                    <div class="col-md-6"><label class="form-label" for="lc">Şu anki konum</label><input id="lc" name="location" class="form-control" value="<%= user.location || '' %>" placeholder="Örn: Ankara"></div>
                    <div class="col-12">
                        <label class="form-label">Hedef şehir (Almanya)</label>
                        <div class="row g-2">
                            <% cities.forEach((c, i) => { %>
                            <div class="col-6 col-md-4 city">
                                <input type="radio" name="targetState" id="city<%= i %>" value="<%= c %>" <%= user.targetState === c ? 'checked' : '' %>>
                                <label for="city<%= i %>"><i class="fas fa-location-dot"></i><%= c %></label>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 px-4 py-3" style="border-top:1px solid var(--line)">
                <button type="reset" class="btn btn-soft">Vazgeç</button>
                <button class="btn btn-brand"><i class="fas fa-check me-1"></i> Değişiklikleri Kaydet</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/cand_shell_end', { page: 'profile' }) %>
<script>cNotify({ ok: { success: 'Profilin güncellendi.' }, err: { invalid_email: 'Geçerli bir e-posta adresi girin.', failed: 'Profil kaydedilemedi, tekrar deneyin.' } });</script>
</body>
</html>
