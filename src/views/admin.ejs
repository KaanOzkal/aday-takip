<%- include('partials/admin_scripts') %>
<script>
(function () {
    const AUDIENCE = <%- JSON.stringify(audience).replace(/</g, '\\u003c') %>;
    const trLower = s => (s || '').toLocaleLowerCase('tr-TR');

    // ---------- Bölüm yönlendirme (hash) ----------
    const sections = [...document.querySelectorAll('.section')];
    function show(name) {
        if (!document.getElementById('sec-' + name)) name = 'dashboard';
        sections.forEach(s => s.classList.toggle('active', s.id === 'sec-' + name));
        document.querySelectorAll('.side-nav a[data-section]').forEach(a => a.classList.toggle('active', a.dataset.section === name));
        const sec = document.getElementById('sec-' + name);
        document.getElementById('pageTitle').textContent = sec.dataset.title;
        document.title = sec.dataset.title + ' | BERLINER Yönetim';
        document.getElementById('sidebar').classList.remove('open'); document.getElementById('backdrop').classList.remove('show');
        window.scrollTo(0, 0);
    }
    window.addEventListener('hashchange', () => show(location.hash.slice(1)));
    show(location.hash.slice(1) || 'dashboard');

    // ---------- Aday tablosu: filtre / sıralama / sayfalama ----------
    const tbody = document.querySelector('#candTable tbody');
    const rows = [...tbody.querySelectorAll('.cand-row')];
    const f = { q: document.getElementById('fSearch'), company: document.getElementById('fCompany'), stage: document.getElementById('fStage'), job: document.getElementById('fJob'), pending: document.getElementById('fPending') };
    const pageSizeEl = document.getElementById('pageSize');
    let page = 1, sortKey = null, sortDir = 1, filtered = rows;
    try { const ps = localStorage.getItem('adm_ps'); if (ps) pageSizeEl.value = ps; } catch (e) {}

    function apply(resetPage = true) {
        const q = trLower(f.q.value.trim());
        const terms = q.split(/\s+/).filter(Boolean);
        filtered = rows.filter(r =>
            terms.every(t => r.dataset.search.includes(t)) &&
            (!f.company.value || r.dataset.company === f.company.value) &&
            (!f.stage.value || r.dataset.stage === f.stage.value) &&
            (!f.job.value || r.dataset.job === f.job.value) &&
            (!f.pending.checked || +r.dataset.docs > 0));
        if (sortKey) {
            const get = { name: r => r.dataset.name, job: r => trLower(r.dataset.job), stage: r => +r.dataset.stageidx, company: r => trLower(r.dataset.company), docs: r => +r.dataset.docs }[sortKey];
            filtered.sort((a, b) => { const x = get(a), y = get(b); return (typeof x === 'number' ? x - y : x.localeCompare(y, 'tr')) * sortDir; });
            filtered.forEach(r => tbody.appendChild(r));
        }
        if (resetPage) page = 1;
        render();
        // Dışa aktar linki filtreyi yansıtsın
        const anyFilter = q || f.company.value || f.stage.value || f.job.value || f.pending.checked;
        document.getElementById('exportBtn').href = anyFilter ? '/admin/export.csv?ids=' + filtered.map(r => r.dataset.id).join(',') : '/admin/export.csv';
    }
    function render() {
        const size = +pageSizeEl.value, pages = Math.max(1, Math.ceil(filtered.length / size));
        page = Math.min(page, pages);
        const start = (page - 1) * size, visible = new Set(filtered.slice(start, start + size));
        rows.forEach(r => r.style.display = visible.has(r) ? '' : 'none');
        document.getElementById('noResults').style.display = filtered.length ? 'none' : 'block';
        document.getElementById('resultInfo').textContent = filtered.length
            ? `${filtered.length} adaydan ${start + 1}–${Math.min(start + size, filtered.length)} gösteriliyor` + (filtered.length !== rows.length ? ` (toplam ${rows.length})` : '')
            : '';
        const pager = document.getElementById('pager'); pager.innerHTML = '';
        if (pages > 1) {
            const btn = (label, p, dis, act) => { const b = document.createElement('button'); b.innerHTML = label; b.disabled = dis; if (act) b.className = 'active'; b.onclick = () => { page = p; render(); }; pager.appendChild(b); };
            btn('<i class="fas fa-chevron-left"></i>', page - 1, page === 1);
            for (let i = 1; i <= pages; i++) if (i === 1 || i === pages || Math.abs(i - page) <= 1) btn(i, i, false, i === page); else if (Math.abs(i - page) === 2) { const s = document.createElement('span'); s.className = 'muted'; s.textContent = '…'; pager.appendChild(s); }
            btn('<i class="fas fa-chevron-right"></i>', page + 1, page === pages);
        }
        syncChecks();
    }
    Object.values(f).forEach(el => el.addEventListener(el.type === 'search' ? 'input' : 'change', () => apply()));
    pageSizeEl.addEventListener('change', () => { try { localStorage.setItem('adm_ps', pageSizeEl.value); } catch (e) {} apply(); });
    document.getElementById('fReset').addEventListener('click', () => { f.q.value = ''; f.company.value = ''; f.stage.value = ''; f.job.value = ''; f.pending.checked = false; apply(); });
    document.querySelectorAll('#candTable th.sortable').forEach(th => th.addEventListener('click', () => {
        sortDir = sortKey === th.dataset.sort ? -sortDir : 1; sortKey = th.dataset.sort;
        document.querySelectorAll('#candTable th.sortable').forEach(x => { x.classList.toggle('sorted', x === th); x.querySelector('.si').className = 'fas si ' + (x === th ? (sortDir === 1 ? 'fa-sort-up' : 'fa-sort-down') : 'fa-sort'); });
        apply(false);
    }));

    // Panodaki kısayollar (aşama/şirket filtresiyle aday listesine git)
    document.querySelectorAll('[data-filter-stage],[data-filter-company]').forEach(a => a.addEventListener('click', () => {
        f.q.value = ''; f.job.value = ''; f.pending.checked = false;
        f.stage.value = a.dataset.filterStage || ''; f.company.value = a.dataset.filterCompany || '';
        apply();
    }));

    // Üst arama -> aday listesi
    const gs = document.getElementById('globalSearch');
    gs.addEventListener('input', () => { if (location.hash !== '#candidates') location.hash = 'candidates'; f.q.value = gs.value; apply(); });
    document.addEventListener('keydown', e => { if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) { e.preventDefault(); gs.focus(); } });

    // Satıra tıklayınca detaya git
    tbody.addEventListener('click', e => {
        if (e.target.closest('.no-row, a, button, select, input')) return;
        const r = e.target.closest('.cand-row'); if (r) location.href = r.dataset.href;
    });

    // ---------- Seçim & toplu işlem ----------
    const bulkBar = document.getElementById('bulkBar'), checkAll = document.getElementById('checkAll');
    const selected = () => rows.filter(r => r.querySelector('.row-check').checked);
    function syncChecks() {
        const sel = selected();
        rows.forEach(r => r.classList.toggle('selected', r.querySelector('.row-check').checked));
        document.getElementById('selCount').textContent = sel.length;
        bulkBar.classList.toggle('show', sel.length > 0);
        const vis = rows.filter(r => r.style.display !== 'none');
        checkAll.checked = vis.length > 0 && vis.every(r => r.querySelector('.row-check').checked);
        checkAll.indeterminate = !checkAll.checked && vis.some(r => r.querySelector('.row-check').checked);
    }
    tbody.addEventListener('change', e => { if (e.target.classList.contains('row-check')) syncChecks(); });
    checkAll.addEventListener('change', () => { rows.filter(r => r.style.display !== 'none').forEach(r => r.querySelector('.row-check').checked = checkAll.checked); syncChecks(); });
    document.getElementById('bulkClear').addEventListener('click', () => { rows.forEach(r => r.querySelector('.row-check').checked = false); syncChecks(); });
    const bulkAction = document.getElementById('bulkAction');
    const sub = { company: 'bulkCompany', stage: 'bulkStage', germanyStage: 'bulkGStage' };
    bulkAction.addEventListener('change', () => Object.entries(sub).forEach(([k, id]) => document.getElementById(id).classList.toggle('d-none', bulkAction.value !== k)));
    bulkBar.addEventListener('submit', async e => {
        e.preventDefault();
        const ids = selected().map(r => r.dataset.id), act = bulkAction.value;
        if (!act) return Swal.fire({ icon: 'info', title: 'Bir işlem seçin', confirmButtonColor: '#2F54EB' });
        if (act === 'export') { location.href = '/admin/export.csv?ids=' + ids.join(','); return; }
        let value = '';
        if (sub[act]) value = document.getElementById(sub[act]).value;
        if (act === 'message') {
            const r = await Swal.fire({ title: `${ids.length} adaya panel mesajı`, input: 'textarea', inputPlaceholder: 'Mesajınızı yazın…', showCancelButton: true, confirmButtonText: 'Gönder', cancelButtonText: 'Vazgeç', confirmButtonColor: '#2F54EB', inputValidator: v => !v.trim() && 'Mesaj boş olamaz' });
            if (!r.isConfirmed) return; value = r.value;
        } else {
            const txt = act === 'delete' ? `${ids.length} aday ve bunlara ait tüm mesaj ve randevular kalıcı olarak silinecek.` : `${ids.length} aday için işlem uygulanacak${value ? ': ' + value : ''}.`;
            if (!(await window.adminAsk(txt, act === 'delete'))) return;
        }
        document.getElementById('bulkIds').value = ids.join(',');
        document.getElementById('bulkValue').value = value;
        bulkBar.submit();
    });

    // ---------- Mesaj modalı ----------
    const msgModal = new bootstrap.Modal(document.getElementById('msgModal'));
    let msgEmail = '';
    function setMsgTab(t) {
        document.querySelectorAll('#msgSeg button').forEach(b => b.classList.toggle('active', b.dataset.t === t));
        document.getElementById('msgPanel').classList.toggle('d-none', t !== 'panel');
        document.getElementById('msgMail').classList.toggle('d-none', t !== 'mail');
    }
    document.querySelectorAll('#msgSeg button').forEach(b => b.addEventListener('click', () => setMsgTab(b.dataset.t)));
    tbody.addEventListener('click', e => {
        const b = e.target.closest('.js-msg'); if (!b) return;
        const r = b.closest('.cand-row');
        document.querySelectorAll('#msgModal .js-cid').forEach(i => i.value = r.dataset.id);
        document.getElementById('msgName').textContent = r.dataset.fullname;
        msgEmail = r.dataset.email;
        document.getElementById('msgEmail').innerHTML = msgEmail ? msgEmail : '<span style="color:var(--bad)">Kayıtlı e-posta yok</span>';
        document.getElementById('msgMailBtn').disabled = !msgEmail;
        setMsgTab('panel'); msgModal.show();
    });

    // ---------- Belge & randevu filtreleri ----------
    function segFilter(segId, bodyId, emptyId, searchId) {
        const seg = document.getElementById(segId), body = document.getElementById(bodyId), search = searchId && document.getElementById(searchId);
        let v = seg.querySelector('.active').dataset.v;
        const run = () => {
            const q = search ? trLower(search.value.trim()) : '';
            let n = 0;
            body.querySelectorAll('tr').forEach(tr => { const ok = (!v || tr.dataset.status === v) && (!q || tr.dataset.search.includes(q)); tr.style.display = ok ? '' : 'none'; if (ok) n++; });
            document.getElementById(emptyId).style.display = n ? 'none' : 'block';
        };
        seg.querySelectorAll('button').forEach(b => b.addEventListener('click', () => { seg.querySelectorAll('button').forEach(x => x.classList.toggle('active', x === b)); v = b.dataset.v; run(); }));
        search && search.addEventListener('input', run);
        run();
    }
    segFilter('docSeg', 'docBody', 'docEmpty', 'docSearch');
    segFilter('appSeg', 'appBody', 'appEmpty');

    // ---------- Şirket yeniden adlandırma ----------
    document.querySelectorAll('.js-rename').forEach(b => b.addEventListener('click', async () => {
        const r = await Swal.fire({ title: 'Şirketi yeniden adlandır', input: 'text', inputValue: b.dataset.name, showCancelButton: true, confirmButtonText: 'Kaydet', cancelButtonText: 'Vazgeç', confirmButtonColor: '#2F54EB',
            footer: '<small class="text-muted">Bu şirkete bağlı adaylar otomatik olarak güncellenir.</small>', inputValidator: v => !v.trim() && 'İsim boş olamaz' });
        if (!r.isConfirmed) return;
        const fm = document.getElementById('renameForm'); fm.elements['id'].value = b.dataset.id; fm.elements['name'].value = r.value.trim(); fm.submit();
    }));

    // ---------- Hedef kitle sayacı ----------
    document.querySelectorAll('.js-audience').forEach(sel => {
        const upd = () => { const a = AUDIENCE[sel.value] || { total: 0, mail: 0 }; document.getElementById(sel.dataset.out).textContent = a[sel.dataset.kind]; };
        sel.addEventListener('change', upd); upd();
    });

    apply();
})();
</script>
</body>
</html>
