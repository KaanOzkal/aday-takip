<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Yönetim Paneli | BERLINER</title>
    <%- include('partials/admin_head') %>
</head>
<body>
<%
    const PALETTE = [['#EEF2FF','#2F54EB'],['#ECFDF3','#039855'],['#FFFAEB','#B54708'],['#FDF2FA','#C11574'],['#F0F9FF','#026AA2'],['#F4F3FF','#5925DC'],['#FEF3F2','#B42318']];
    const avatarStyle = (n) => { let h = 0; for (const ch of String(n || '')) h = (h * 31 + ch.charCodeAt(0)) >>> 0; const c = PALETTE[h % PALETTE.length]; return `background:${c[0]};color:${c[1]}`; };
    const initials = (c) => (((c.firstName || '?').charAt(0)) + ((c.lastName || '').charAt(0))).toLocaleUpperCase('tr-TR');
    const fullName = (c) => `${c.firstName || ''} ${c.lastName || ''}`.trim();
    const fmtDate = (d) => { if (!d) return '—'; const x = new Date(d); return isNaN(x) ? String(d) : x.toLocaleDateString('tr-TR', { day: '2-digit', month: 'short', year: 'numeric' }); };
    const stageIdx = (s) => stages.indexOf(s);
    const stagePct = (s) => { const i = stageIdx(s); return i < 0 ? 0 : Math.round(((i + 1) / stages.length) * 100); };
    const stageTone = (s) => { const i = stageIdx(s); if (i === stages.length - 1) return 't-ok'; if (i >= 5) return 't-info'; if (i >= 2) return 't-brand'; return 't-gray'; };
    const statusTone = (s) => s === 'Onaylandı' ? 't-ok' : s === 'Reddedildi' ? 't-bad' : 't-warn';
    const docUrl = (d) => d.fileId ? `/documents/view/${d._id}` : (d.driveLink || (d.filename ? `/uploads/${encodeURIComponent(d.filename)}` : '#'));
    const pendingDocs = allDocuments.filter(d => d.status === 'İnceleniyor');
    const pendingApps = appointments.filter(a => a.status === 'Beklemede');
    const maxStage = Math.max(1, ...stageCounts.map(s => s.count));
    const audience = { 'Tümü': { total: candidates.length, mail: candidates.filter(c => c.email && c.email.trim()).length } };
    companyCounts.forEach(co => {
        const list = candidates.filter(c => co.name === 'Atanmadı' ? (!c.company || c.company === 'Atanmadı') : c.company === co.name);
        audience[co.name] = { total: list.length, mail: list.filter(c => c.email && c.email.trim()).length };
    });
%>
<div class="app">
    <%- include('partials/admin_sidebar', { active: 'dashboard', onMain: true, stats }) %>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-soft btn-icon menu-toggle" aria-label="Menü"><i class="fas fa-bars"></i></button>
            <div>
                <div class="crumb">BERLINER Yönetim</div>
                <h1 id="pageTitle">Genel Bakış</h1>
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                <div class="search d-none d-md-block" style="width:280px">
                    <i class="fas fa-magnifying-glass"></i>
                    <input type="search" id="globalSearch" class="form-control" placeholder="Aday ara (ad, pasaport, e-posta)…  /">
                </div>
                <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#addCandidateModal"><i class="fas fa-plus me-1"></i><span class="d-none d-sm-inline"> Yeni Aday</span></button>
            </div>
        </header>

        <main class="content">

            <!-- ================= GENEL BAKIŞ ================= -->
            <section class="section" id="sec-dashboard" data-title="Genel Bakış">
                <div class="row g-3 mb-3">
                    <div class="col-6 col-xl">
                        <a class="card-x kpi" href="#candidates">
                            <div class="ic t-brand"><i class="fas fa-users"></i></div>
                            <div><div class="lbl">Toplam Aday</div><div class="val"><%= stats.total %></div><div class="hint">Kayıtlı tüm adaylar</div></div>
                        </a>
                    </div>
                    <div class="col-6 col-xl">
                        <a class="card-x kpi" href="#documents">
                            <div class="ic t-warn"><i class="fas fa-file-circle-exclamation"></i></div>
                            <div><div class="lbl">Bekleyen Belge</div><div class="val"><%= stats.pendingDocs %></div><div class="hint">Onay bekliyor</div></div>
                        </a>
                    </div>
                    <div class="col-6 col-xl">
                        <a class="card-x kpi" href="#appointments">
                            <div class="ic t-info"><i class="fas fa-calendar-day"></i></div>
                            <div><div class="lbl">Bekleyen Randevu</div><div class="val"><%= stats.pendingAppointments %></div><div class="hint">Yanıt bekliyor</div></div>
                        </a>
                    </div>
                    <div class="col-6 col-xl">
                        <a class="card-x kpi" href="#candidates" data-filter-stage="Almanya'da">
                            <div class="ic t-ok"><i class="fas fa-plane-arrival"></i></div>
                            <div><div class="lbl">Almanya'da</div><div class="val"><%= stats.inGermany %></div><div class="hint">Süreci tamamlanan</div></div>
                        </a>
                    </div>
                    <div class="col-12 col-xl">
                        <a class="card-x kpi" href="#candidates" data-filter-company="Atanmadı">
                            <div class="ic t-gray"><i class="fas fa-user-tag"></i></div>
                            <div><div class="lbl">Şirket Atanmamış</div><div class="val"><%= stats.unassigned %></div><div class="hint">Eşleştirme bekliyor</div></div>
                        </a>
                    </div>
                </div>

                <% if (stats.noEmail > 0) { %>
                <div class="alert d-flex align-items-center gap-2 border-0 mb-3" style="background:var(--warn-50);color:#93370D;border-radius:12px">
                    <i class="fas fa-circle-info"></i>
                    <div><strong><%= stats.noEmail %></strong> adayın e-posta adresi eksik — bu adaylara e-posta gönderilemez. Aday detayından ekleyebilirsiniz.</div>
                </div>
                <% } %>

                <div class="row g-3 mb-3">
                    <div class="col-lg-8">
                        <div class="card-x h-100">
                            <div class="card-h"><div><h2>Süreç Hunisi</h2><p class="sub">Adayların genel süreç aşamalarına göre dağılımı. Bir aşamaya tıklayarak listeleyin.</p></div></div>
                            <div class="card-b">
                                <% stageCounts.forEach((s, i) => { %>
                                <a href="#candidates" data-filter-stage="<%= s.name %>" class="d-flex align-items-center gap-3 mb-2 text-decoration-none" style="color:inherit">
                                    <div class="muted fw-semibold" style="width:22px;font-size:12px"><%= i + 1 %></div>
                                    <div style="width:150px" class="fw-650 text-truncate-1"><%= s.name %></div>
                                    <div class="bar flex-grow-1"><span style="width:<%= Math.max(s.count ? 3 : 0, Math.round(s.count / maxStage * 100)) %>%;<%= i === stages.length - 1 ? 'background:var(--ok)' : '' %>"></span></div>
                                    <div class="fw-bold text-end" style="width:36px"><%= s.count %></div>
                                </a>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card-x h-100">
                            <div class="card-h"><div><h2>Şirket Dağılımı</h2><p class="sub">Atanan aday sayıları</p></div>
                                <a href="#companies" class="btn btn-soft btn-sm ms-auto">Yönet</a></div>
                            <div>
                                <% companyCounts.forEach(co => { %>
                                <a href="#candidates" data-filter-company="<%= co.name %>" class="list-row text-decoration-none" style="color:inherit">
                                    <div class="avatar" style="<%= co.name === 'Atanmadı' ? 'background:#F2F4F7;color:#667085' : avatarStyle(co.name) %>;border-radius:10px"><i class="fas <%= co.name === 'Atanmadı' ? 'fa-user-slash' : 'fa-building' %>"></i></div>
                                    <div class="flex-grow-1 fw-650 text-truncate-1"><%= co.name %></div>
                                    <span class="pill t-gray"><%= co.count %></span>
                                </a>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-lg-7">
                        <div class="card-x h-100">
                            <div class="card-h"><div><h2>Onay Bekleyen Belgeler</h2><p class="sub">En son yüklenenler</p></div>
                                <a href="#documents" class="btn btn-soft btn-sm ms-auto">Tümünü gör</a></div>
                            <% if (pendingDocs.length === 0) { %>
                                <div class="empty"><i class="fas fa-circle-check"></i>Bekleyen belge yok. Harika!</div>
                            <% } else { pendingDocs.slice(0, 6).forEach(d => { %>
                                <div class="list-row">
                                    <div class="avatar t-warn" style="border-radius:10px"><i class="fas fa-file-lines"></i></div>
                                    <div class="flex-grow-1" style="min-width:0">
                                        <div class="fw-650 text-truncate-1"><%= d.name || d.filename %></div>
                                        <div class="muted small"><a href="/admin/candidate/<%= d.candidateId %>#documents" class="text-decoration-none"><%= d.candidateName %></a> · <%= fmtDate(d.date) %></div>
                                    </div>
                                    <a href="<%= docUrl(d) %>" target="_blank" class="btn btn-soft btn-icon" title="Görüntüle"><i class="fas fa-eye"></i></a>
                                    <form action="/admin/document/status" method="POST" class="m-0">
                                        <input type="hidden" name="returnTo" value="/admin#dashboard"><input type="hidden" name="candidateId" value="<%= d.candidateId %>"><input type="hidden" name="docId" value="<%= d._id %>"><input type="hidden" name="status" value="Onaylandı">
                                        <button class="btn btn-ok btn-icon" title="Onayla"><i class="fas fa-check"></i></button>
                                    </form>
                                    <form action="/admin/document/status" method="POST" class="m-0">
                                        <input type="hidden" name="returnTo" value="/admin#dashboard"><input type="hidden" name="candidateId" value="<%= d.candidateId %>"><input type="hidden" name="docId" value="<%= d._id %>"><input type="hidden" name="status" value="Reddedildi">
                                        <button class="btn btn-bad-soft btn-icon" title="Reddet"><i class="fas fa-xmark"></i></button>
                                    </form>
                                </div>
                            <% }) } %>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="card-x h-100">
                            <div class="card-h"><div><h2>Bekleyen Randevular</h2><p class="sub">Yanıt bekleyen talepler</p></div>
                                <a href="#appointments" class="btn btn-soft btn-sm ms-auto">Tümünü gör</a></div>
                            <% if (pendingApps.length === 0) { %>
                                <div class="empty"><i class="fas fa-calendar-check"></i>Bekleyen randevu yok.</div>
                            <% } else { pendingApps.slice(0, 6).forEach(a => { %>
                                <div class="list-row">
                                    <div class="text-center t-brand" style="width:48px;border-radius:10px;padding:6px 0;line-height:1.1">
                                        <div class="fw-bold" style="font-size:15px"><%= a.date ? new Date(a.date).getDate() || '—' : '—' %></div>
                                        <div style="font-size:10.5px;text-transform:uppercase"><%= a.date && !isNaN(new Date(a.date)) ? new Date(a.date).toLocaleDateString('tr-TR', { month: 'short' }) : '' %></div>
                                    </div>
                                    <div class="flex-grow-1" style="min-width:0">
                                        <div class="fw-650 text-truncate-1"><%= a.candidateId ? fullName(a.candidateId) : 'Silinmiş aday' %></div>
                                        <div class="muted small text-truncate-1"><%= a.type || 'Randevu' %> · <%= a.time || '' %></div>
                                    </div>
                                    <form action="/admin/appointment/status" method="POST" class="m-0">
                                        <input type="hidden" name="returnTo" value="/admin#dashboard"><input type="hidden" name="appId" value="<%= a._id %>"><input type="hidden" name="status" value="Onaylandı">
                                        <button class="btn btn-ok btn-icon" title="Onayla"><i class="fas fa-check"></i></button>
                                    </form>
                                    <form action="/admin/appointment/status" method="POST" class="m-0">
                                        <input type="hidden" name="returnTo" value="/admin#dashboard"><input type="hidden" name="appId" value="<%= a._id %>"><input type="hidden" name="status" value="Reddedildi">
                                        <button class="btn btn-bad-soft btn-icon" title="Reddet"><i class="fas fa-xmark"></i></button>
                                    </form>
                                </div>
                            <% }) } %>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ================= ADAYLAR ================= -->
            <section class="section" id="sec-candidates" data-title="Adaylar">
                <div class="card-x">
                    <div class="card-h">
                        <div class="search flex-grow-1" style="min-width:220px;max-width:360px">
                            <i class="fas fa-magnifying-glass"></i>
                            <input type="search" id="fSearch" class="form-control" placeholder="Ad, soyad, pasaport, e-posta, telefon…">
                        </div>
                        <select id="fCompany" class="form-select" style="width:auto;min-width:160px">
                            <option value="">Tüm şirketler</option>
                            <option value="Atanmadı">Atanmadı</option>
                            <% companies.forEach(c => { %><option value="<%= c.name %>"><%= c.name %></option><% }) %>
                        </select>
                        <select id="fStage" class="form-select" style="width:auto;min-width:160px">
                            <option value="">Tüm aşamalar</option>
                            <% stages.forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
                        </select>
                        <select id="fJob" class="form-select" style="width:auto;min-width:140px">
                            <option value="">Tüm meslekler</option>
                            <% jobs.forEach(j => { %><option value="<%= j %>"><%= j %></option><% }) %>
                        </select>
                        <div class="form-check form-switch ms-1 mb-0">
                            <input class="form-check-input" type="checkbox" id="fPending">
                            <label class="form-check-label small fw-semibold" for="fPending">Bekleyen belgesi olanlar</label>
                        </div>
                        <button class="btn btn-soft btn-sm" id="fReset" type="button"><i class="fas fa-rotate-left me-1"></i>Sıfırla</button>
                        <a class="btn btn-soft btn-sm ms-auto" id="exportBtn" href="/admin/export.csv"><i class="fas fa-download me-1"></i>Dışa aktar</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-x" id="candTable">
                            <thead>
                                <tr>
                                    <th style="width:36px"><input class="form-check-input" type="checkbox" id="checkAll" title="Görünenlerin tümünü seç"></th>
                                    <th class="sortable" data-sort="name">Aday <i class="fas fa-sort si"></i></th>
                                    <th class="sortable d-none d-lg-table-cell" data-sort="job">Meslek / Lokasyon <i class="fas fa-sort si"></i></th>
                                    <th class="sortable" data-sort="stage">Süreç <i class="fas fa-sort si"></i></th>
                                    <th class="sortable" data-sort="company">Şirket <i class="fas fa-sort si"></i></th>
                                    <th class="sortable text-center d-none d-md-table-cell" data-sort="docs">Belge <i class="fas fa-sort si"></i></th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                            <% candidates.forEach(c => {
                                const pend = (c.documents || []).filter(d => d.status === 'İnceleniyor').length;
                                const comp = c.company || 'Atanmadı';
                                const search = [fullName(c), c.email, c.passportNo, c.phone, c.phoneNumber, c.location, c.job, c.targetState].filter(Boolean).join(' ').toLocaleLowerCase('tr-TR');
                            %>
                                <tr class="clickable cand-row" data-id="<%= c._id %>" data-href="/admin/candidate/<%= c._id %>"
                                    data-search="<%= search %>" data-company="<%= comp %>" data-stage="<%= c.currentStage %>" data-job="<%= c.job || '' %>"
                                    data-name="<%= fullName(c).toLocaleLowerCase('tr-TR') %>" data-stageidx="<%= stageIdx(c.currentStage) %>" data-docs="<%= pend %>" data-email="<%= c.email || '' %>" data-fullname="<%= fullName(c) %>">
                                    <td class="no-row"><input class="form-check-input row-check" type="checkbox" value="<%= c._id %>"></td>
                                    <td>
                                        <div class="person">
                                            <div class="avatar" style="<%= avatarStyle(fullName(c)) %>"><%= initials(c) %></div>
                                            <div style="min-width:0">
                                                <div class="nm text-truncate-1"><%= fullName(c) %></div>
                                                <div class="sm text-truncate-1"><% if (c.email) { %><%= c.email %><% } else { %><span style="color:var(--warn)"><i class="fas fa-triangle-exclamation me-1"></i>E-posta yok</span><% } %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="d-none d-lg-table-cell">
                                        <div class="fw-650"><%= c.job || '—' %></div>
                                        <div class="muted small"><i class="fas fa-location-dot me-1 opacity-50"></i><%= c.location || '—' %><% if (c.targetState && c.targetState !== 'Belirtilmedi') { %> → <%= c.targetState %><% } %></div>
                                    </td>
                                    <td style="min-width:170px">
                                        <span class="pill <%= stageTone(c.currentStage) %>"><span class="dot"></span><%= c.currentStage || '—' %></span>
                                        <div class="bar mt-2" style="height:4px;max-width:150px"><span style="width:<%= stagePct(c.currentStage) %>%"></span></div>
                                    </td>
                                    <td class="no-row">
                                        <form action="/admin/candidate/company" method="POST" class="m-0">
                                            <input type="hidden" name="returnTo" value="/admin#candidates">
                                            <input type="hidden" name="candidateId" value="<%= c._id %>">
                                            <select name="newCompany" class="form-select form-select-sm" style="min-width:140px;font-size:13px" onchange="this.form.submit()">
                                                <option value="Atanmadı" <%= comp === 'Atanmadı' ? 'selected' : '' %>>Atanmadı</option>
                                                <% companies.forEach(co => { %><option value="<%= co.name %>" <%= comp === co.name ? 'selected' : '' %>><%= co.name %></option><% }) %>
                                            </select>
                                        </form>
                                    </td>
                                    <td class="text-center d-none d-md-table-cell">
                                        <% if (pend > 0) { %><span class="pill t-warn" title="Onay bekleyen belge"><%= pend %> bekliyor</span>
                                        <% } else { %><span class="muted small"><%= (c.documents || []).length %></span><% } %>
                                    </td>
                                    <td class="text-end no-row" style="white-space:nowrap">
                                        <button class="btn btn-soft btn-icon js-msg" title="Mesaj / E-posta gönder"><i class="far fa-paper-plane"></i></button>
                                        <a href="/admin/candidate/<%= c._id %>" class="btn btn-soft btn-icon" title="Detayı aç"><i class="fas fa-chevron-right"></i></a>
                                    </td>
                                </tr>
                            <% }) %>
                            </tbody>
                        </table>
                        <div class="empty" id="noResults" style="display:none"><i class="fas fa-user-magnifying-glass fa-magnifying-glass"></i>Filtrelere uyan aday bulunamadı.</div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 px-3 py-3 border-top" style="border-color:var(--line)!important">
                        <div class="muted small" id="resultInfo"></div>
                        <div class="d-flex align-items-center gap-2">
                            <select id="pageSize" class="form-select form-select-sm" style="width:auto">
                                <option value="25">25 / sayfa</option><option value="50">50 / sayfa</option><option value="100">100 / sayfa</option><option value="100000">Tümü</option>
                            </select>
                            <div class="pagination-x" id="pager"></div>
                        </div>
                    </div>
                </div>

                <!-- Toplu işlem çubuğu -->
                <form class="bulkbar" id="bulkBar" action="/admin/candidates/bulk" method="POST">
                    <input type="hidden" name="returnTo" value="/admin#candidates">
                    <input type="hidden" name="ids" id="bulkIds">
                    <input type="hidden" name="value" id="bulkValue">
                    <div class="fw-semibold me-1"><span id="selCount">0</span> aday seçildi</div>
                    <select name="action" id="bulkAction" class="form-select">
                        <option value="">Toplu işlem seçin…</option>
                        <option value="company">Şirkete ata</option>
                        <option value="stage">Genel aşamayı değiştir</option>
                        <option value="germanyStage">Almanya aşamasını değiştir</option>
                        <option value="message">Panel mesajı gönder</option>
                        <option value="export">Seçilenleri dışa aktar</option>
                        <option value="delete">Seçilenleri sil</option>
                    </select>
                    <select id="bulkCompany" class="form-select d-none">
                        <option value="Atanmadı">Atanmadı</option>
                        <% companies.forEach(co => { %><option value="<%= co.name %>"><%= co.name %></option><% }) %>
                    </select>
                    <select id="bulkStage" class="form-select d-none">
                        <% stages.forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
                    </select>
                    <select id="bulkGStage" class="form-select d-none">
                        <% germanyStages.forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
                    </select>
                    <button type="submit" class="btn btn-brand btn-sm" data-no-busy="1">Uygula</button>
                    <button type="button" class="btn btn-sm ms-auto" style="color:#CBD5E1" id="bulkClear">Seçimi temizle</button>
                </form>
            </section>

            <!-- ================= BELGELER ================= -->
            <section class="section" id="sec-documents" data-title="Belge Onayları">
                <div class="card-x">
                    <div class="card-h">
                        <div><h2>Tüm Belgeler</h2><p class="sub">Adayların yüklediği belgeleri inceleyin ve onaylayın.</p></div>
                        <div class="seg ms-auto" id="docSeg">
                            <button class="active" data-v="İnceleniyor">Bekleyen <span class="c"><%= pendingDocs.length %></span></button>
                            <button data-v="Onaylandı">Onaylanan <span class="c"><%= allDocuments.filter(d => d.status === 'Onaylandı').length %></span></button>
                            <button data-v="Reddedildi">Reddedilen <span class="c"><%= allDocuments.filter(d => d.status === 'Reddedildi').length %></span></button>
                            <button data-v="">Tümü <span class="c"><%= allDocuments.length %></span></button>
                        </div>
                        <div class="search" style="width:240px"><i class="fas fa-magnifying-glass"></i><input type="search" id="docSearch" class="form-control form-control-sm" placeholder="Belge veya aday ara"></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-x">
                            <thead><tr><th>Belge</th><th>Aday</th><th class="d-none d-md-table-cell">Yüklenme</th><th>Durum</th><th class="text-end">İşlem</th></tr></thead>
                            <tbody id="docBody">
                            <% allDocuments.forEach(d => { %>
                                <tr data-status="<%= d.status %>" data-search="<%= ((d.name || '') + ' ' + (d.filename || '') + ' ' + d.candidateName).toLocaleLowerCase('tr-TR') %>">
                                    <td style="max-width:340px">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fas fa-file-lines muted"></i>
                                            <div style="min-width:0"><div class="fw-650 text-truncate-1"><%= d.name || 'Belge' %></div><div class="muted small text-truncate-1"><%= d.filename %></div></div>
                                        </div>
                                    </td>
                                    <td><a class="fw-600 text-decoration-none" href="/admin/candidate/<%= d.candidateId %>#documents"><%= d.candidateName %></a></td>
                                    <td class="d-none d-md-table-cell muted"><%= fmtDate(d.date) %></td>
                                    <td><span class="pill <%= statusTone(d.status) %>"><span class="dot"></span><%= d.status %></span></td>
                                    <td class="text-end" style="white-space:nowrap">
                                        <a href="<%= docUrl(d) %>" target="_blank" class="btn btn-soft btn-sm"><i class="fas fa-eye me-1"></i>Görüntüle</a>
                                        <% if (d.status !== 'Onaylandı') { %>
                                        <form action="/admin/document/status" method="POST" class="d-inline m-0">
                                            <input type="hidden" name="returnTo" value="/admin#documents"><input type="hidden" name="candidateId" value="<%= d.candidateId %>"><input type="hidden" name="docId" value="<%= d._id %>"><input type="hidden" name="status" value="Onaylandı">
                                            <button class="btn btn-ok btn-sm"><i class="fas fa-check me-1"></i>Onayla</button>
                                        </form>
                                        <% } %>
                                        <% if (d.status !== 'Reddedildi') { %>
                                        <form action="/admin/document/status" method="POST" class="d-inline m-0">
                                            <input type="hidden" name="returnTo" value="/admin#documents"><input type="hidden" name="candidateId" value="<%= d.candidateId %>"><input type="hidden" name="docId" value="<%= d._id %>"><input type="hidden" name="status" value="Reddedildi">
                                            <button class="btn btn-bad-soft btn-sm"><i class="fas fa-xmark me-1"></i>Reddet</button>
                                        </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                            </tbody>
                        </table>
                        <div class="empty" id="docEmpty" style="display:none"><i class="fas fa-folder-open"></i>Bu filtrede belge yok.</div>
                    </div>
                </div>
            </section>

            <!-- ================= RANDEVULAR ================= -->
            <section class="section" id="sec-appointments" data-title="Randevular">
                <div class="card-x">
                    <div class="card-h">
                        <div><h2>Randevu Talepleri</h2><p class="sub">Adayların oluşturduğu randevuları yönetin.</p></div>
                        <div class="seg ms-auto" id="appSeg">
                            <button class="active" data-v="Beklemede">Bekleyen <span class="c"><%= pendingApps.length %></span></button>
                            <button data-v="Onaylandı">Onaylanan <span class="c"><%= appointments.filter(a => a.status === 'Onaylandı').length %></span></button>
                            <button data-v="Reddedildi">Reddedilen <span class="c"><%= appointments.filter(a => a.status === 'Reddedildi').length %></span></button>
                            <button data-v="">Tümü <span class="c"><%= appointments.length %></span></button>
