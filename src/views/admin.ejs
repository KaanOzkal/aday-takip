                                        <% if (a.candidateId) { %>
                                        <a href="/admin/candidate/<%= a.candidateId._id %>#appointments" class="person text-decoration-none">
                                            <div class="avatar" style="<%= avatarStyle(fullName(a.candidateId)) %>"><%= initials(a.candidateId) %></div>
                                            <div class="nm"><%= fullName(a.candidateId) %></div>
                                        </a>
                                        <% } else { %><span class="muted">Silinmiş aday</span><% } %>
                                    </td>
                                    <td class="fw-650"><%= a.type || '—' %></td>
                                    <td><div class="fw-650"><%= fmtDate(a.date) %></div><div class="muted small"><%= a.time || '' %></div></td>
                                    <td class="d-none d-md-table-cell muted"><%= fmtDate(a.createdAt) %></td>
                                    <td><span class="pill <%= statusTone(a.status) %>"><span class="dot"></span><%= a.status %></span></td>
                                    <td class="text-end" style="white-space:nowrap">
                                        <% if (a.status !== 'Onaylandı') { %>
                                        <form action="/admin/appointment/status" method="POST" class="d-inline m-0">
                                            <input type="hidden" name="returnTo" value="/admin#appointments"><input type="hidden" name="appId" value="<%= a._id %>"><input type="hidden" name="status" value="Onaylandı">
                                            <button class="btn btn-ok btn-sm"><i class="fas fa-check me-1"></i>Onayla</button>
                                        </form>
                                        <% } %>
                                        <% if (a.status !== 'Reddedildi') { %>
                                        <form action="/admin/appointment/status" method="POST" class="d-inline m-0">
                                            <input type="hidden" name="returnTo" value="/admin#appointments"><input type="hidden" name="appId" value="<%= a._id %>"><input type="hidden" name="status" value="Reddedildi">
                                            <button class="btn btn-bad-soft btn-sm"><i class="fas fa-xmark me-1"></i>Reddet</button>
                                        </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                            </tbody>
                        </table>
