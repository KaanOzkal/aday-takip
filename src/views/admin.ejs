                        <table class="table table-x">
                            <thead><tr><th>Aday</th><th>Randevu Türü</th><th>Tarih / Saat</th><th class="d-none d-md-table-cell">Talep</th><th>Durum</th><th class="text-end">İşlem</th></tr></thead>
