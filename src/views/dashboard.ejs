<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Ana Sayfa | BERLINER Aday Portalı</title>
    <%- include('partials/cand_head') %>
    <style>
        .ring { --p: 0; width: 120px; height: 120px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0;
            background: conic-gradient(#7EA2FF calc(var(--p) * 1%), rgba(255,255,255,.12) 0); }
        .ring > div { width: 96px; height: 96px; border-radius: 50%; background: #111c3a; display: grid; place-items: center; text-align: center; }
        .ring b { font-size: 26px; font-weight: 800; color: #fff; line-height: 1; display: block; }
        .ring small { color: rgba(255,255,255,.6); font-size: 11px; }
        .quick a { display: flex; align-items: center; gap: 12px; padding: 16px; height: 100%; text-decoration: none; color: inherit; transition: border-color .15s, transform .15s, box-shadow .15s; }
        .quick a:hover { border-color: #C7D2FE; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(47,84,235,.08); }
        .quick .t { font-weight: 650; color: var(--ink); line-height: 1.2; }
        .quick .s { color: var(--muted); font-size: 12.5px; }
        .todo { display: flex; align-items: center; gap: 12px; padding: 12px 20px; border-bottom: 1px solid #F0F2F5; text-decoration: none; color: inherit; }
        .todo:last-child { border-bottom: 0; }
        .todo:hover { background: #FAFBFF; }
        .todo .ck { width: 24px; height: 24px; border-radius: 50%; border: 2px solid #D0D5DD; display: grid; place-items: center; font-size: 11px; color: #fff; flex-shrink: 0; }
        .todo.done .ck { background: var(--ok); border-color: var(--ok); }
        .todo.done .tt { color: var(--muted); text-decoration: line-through; }
        .steps { display: flex; overflow-x: auto; padding: 4px 0 6px; scrollbar-width: thin; }
        .st { flex: 1; min-width: 72px; text-align: center; position: relative; }
        .st::before { content: ''; position: absolute; top: 13px; left: -50%; width: 100%; height: 3px; background: #E4E7EC; }
        .st:first-child::before { display: none; }
        .st.done::before, .st.cur::before { background: var(--brand); }
        .st .b { position: relative; z-index: 1; width: 28px; height: 28px; margin: 0 auto 6px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 700; background: #fff; border: 2px solid #D0D5DD; color: #98A2B3; }
        .st.done .b { background: var(--brand); border-color: var(--brand); color: #fff; }
        .st.cur .b { border-color: var(--brand); color: var(--brand); box-shadow: 0 0 0 5px rgba(47,84,235,.14); }
        .st .l { font-size: 11.5px; color: var(--muted); line-height: 1.25; padding: 0 3px; }
        .st.cur .l { color: var(--ink); font-weight: 700; }
        .wx { text-align: center; padding: 14px 8px; }
        .wx .c { font-size: 11px; font-weight: 700; letter-spacing: .8px; color: var(--muted); text-transform: uppercase; }
        .wx .i { font-size: 24px; margin: 8px 0 4px; }
        .wx .tp { font-size: 22px; font-weight: 800; color: var(--ink); line-height: 1; }
        .wx .d { font-size: 12px; color: var(--muted); margin-top: 4px; }
        .word { background: linear-gradient(135deg, #0B1220, #1E293B); color: #fff; border-radius: var(--radius); padding: 22px; position: relative; overflow: hidden; }
        .word h3 { color: var(--gold); font-weight: 800; font-size: 26px; margin: 10px 0 2px; }
        .msg-row { display: flex; gap: 12px; padding: 12px 20px; border-bottom: 1px solid #F0F2F5; text-decoration: none; color: inherit; }
        .msg-row:last-child { border-bottom: 0; }
        .msg-row:hover { background: #FAFBFF; }
    </style>
</head>
<body>
<%
    const fmt = (d, o) => { const x = new Date(d); return isNaN(x) ? (d || '') : x.toLocaleDateString('tr-TR', o || { day: 'numeric', month: 'short' }); };
    const curIdx = stages.indexOf(user.currentStage);
    const nextStage = curIdx >= 0 && curIdx < stages.length - 1 ? stages[curIdx + 1] : null;
    const docs = user.documents || [];
    const af = user.applicationForm || {};
    const cv = user.cvDetails || {};
    const hasTarget = user.targetState && user.targetState !== 'Belirtilmedi';
    const todos = [
        { t: 'İletişim bilgilerini tamamla', s: 'E-posta ve telefon numarası', done: !!(user.email && (user.phone || user.phoneNumber)), href: '/profile' },
        { t: 'Hedef şehrini seç', s: "Almanya'da çalışmak istediğin şehir", done: !!hasTarget, href: '/profile' },
        { t: 'Pasaportunu yükle', s: 'Belgelerim sayfasından', done: docs.some(d => d.name === 'Pasaport'), href: '/documents' },
        { t: 'Başvuru formunu doldur', s: 'Motivasyon ve kişisel bilgiler', done: !!(af.birthPlace || af.workHistory || af.germanyDesire), href: '/application-form' },
        { t: 'CV\'ni oluştur', s: 'Akıllı CV oluşturucu ile', done: !!(cv.summary || (cv.experience1 && cv.experience1.title)), href: '/cv-builder' }
    ];
    const doneCount = todos.filter(t => t.done).length;
    const pendingDocs = docs.filter(d => d.status === 'İnceleniyor').length;
    const rejectedDocs = docs.filter(d => d.status === 'Reddedildi').length;
    const approvedDocs = docs.filter(d => d.status === 'Onaylandı').length;
    const appts = (typeof appointments !== 'undefined' && appointments) ? appointments : [];
    const nextAppt = appts.find(a => a.status !== 'Reddedildi' && new Date(a.date) >= new Date(new Date().toDateString()));
    const hour = new Date().getHours();
    const greet = hour < 6 ? 'İyi geceler' : hour < 12 ? 'Günaydın' : hour < 18 ? 'İyi günler' : 'İyi akşamlar';
%>
<%- include('partials/cand_shell_start', { page: 'panel', title: 'Ana Sayfa', subtitle: new Date().toLocaleDateString('tr-TR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) }) %>

<!-- HERO -->
<section class="hero mb-3">
    <div class="d-flex flex-column flex-md-row align-items-md-center gap-4 position-relative" style="z-index:1">
        <div class="flex-grow-1">
            <div class="flag mb-3"><span style="background:#111"></span><span style="background:#DD0000"></span><span style="background:#FFCE00"></span></div>
            <h2 class="mb-2" style="font-size:28px"><%= greet %>, <%= user.firstName %> 👋</h2>
            <p class="mb-3" style="color:rgba(255,255,255,.75);max-width:560px">
                Başvurun şu anda <strong style="color:#fff"><%= user.currentStage %></strong> aşamasında.
                <% if (nextStage) { %>Sıradaki adım: <strong style="color:#fff"><%= nextStage %></strong>.<% } else if (curIdx === stages.length - 1) { %>Tebrikler, süreci tamamladın! 🎉<% } %>
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a href="/processes" class="btn btn-sm" style="background:#fff;color:var(--ink)"><i class="fas fa-route me-1"></i> Süreci görüntüle</a>
                <a href="/documents" class="btn btn-sm" style="background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.18)"><i class="fas fa-upload me-1"></i> Belge yükle</a>
            </div>
        </div>
        <div class="d-flex align-items-center gap-4">
            <div class="ring" style="--p: <%= progress %>"><div><span><b>%<%= progress %></b><small>Tamamlandı</small></span></div></div>
            <div class="d-none d-lg-block" style="color:rgba(255,255,255,.75);font-size:13px;line-height:1.9">
                <div><i class="fas fa-star me-2" style="color:var(--gold)"></i>Profil puanı <b style="color:#fff"><%= user.score %></b></div>
                <div><i class="fas fa-building me-2"></i><%= user.company && user.company !== 'Atanmadı' ? user.company : 'İşveren eşleşmesi bekleniyor' %></div>
                <div><i class="fas fa-location-dot me-2"></i><%= hasTarget ? user.targetState : 'Hedef şehir seçilmedi' %></div>
            </div>
        </div>
    </div>
</section>

<% if (rejectedDocs > 0) { %>
<div class="d-flex align-items-center gap-3 p-3 mb-3" style="background:var(--bad-50);border:1px solid #FECDCA;border-radius:14px;color:#912018">
    <i class="fas fa-circle-exclamation fa-lg"></i>
    <div class="flex-grow-1"><strong><%= rejectedDocs %> belgen reddedildi.</strong> Lütfen kontrol edip yeniden yükle.</div>
    <a href="/documents" class="btn btn-sm" style="background:var(--bad);color:#fff">Belgelere git</a>
</div>
<% } %>

<!-- HIZLI İŞLEMLER -->
<div class="row g-3 mb-3 quick">
    <div class="col-6 col-xl-3"><a class="c-card" href="/documents"><div class="c-ic t-brand"><i class="fas fa-folder-open"></i></div><div><div class="t">Belgelerim</div><div class="s"><%= docs.length %> yüklü<% if (pendingDocs) { %> · <%= pendingDocs %> inceleniyor<% } %></div></div></a></div>
    <div class="col-6 col-xl-3"><a class="c-card" href="/appointments"><div class="c-ic t-info"><i class="fas fa-calendar-plus"></i></div><div><div class="t">Randevu Al</div><div class="s"><%= nextAppt ? fmt(nextAppt.date) + ' · ' + nextAppt.time : 'Danışmanla görüş' %></div></div></a></div>
    <div class="col-6 col-xl-3"><a class="c-card" href="/messages"><div class="c-ic t-warn"><i class="fas fa-comments"></i></div><div><div class="t">Mesajlar</div><div class="s"><%= locals.unreadCount ? unreadCount + ' okunmamış' : messages.length + ' mesaj' %></div></div></a></div>
    <div class="col-6 col-xl-3"><a class="c-card" href="/german"><div class="c-ic t-ok"><i class="fas fa-language"></i></div><div><div class="t">Almanca Çalış</div><div class="s">Lojistik kelimeleri</div></div></a></div>
</div>

<div class="row g-3 mb-3">
    <!-- SÜREÇ -->
    <div class="col-lg-8">
        <div class="c-card h-100">
            <div class="c-card-h"><div><h2>Süreç Durumu</h2><p class="sub"><%= curIdx + 1 %> / <%= stages.length %>. adımdasın</p></div><a href="/processes" class="btn btn-soft btn-sm ms-auto">Detaylar</a></div>
            <div class="c-card-b">
                <div class="steps">
                    <% stages.forEach((s, i) => { %>
                        <div class="st <%= i < curIdx ? 'done' : i === curIdx ? 'cur' : '' %>">
                            <div class="b"><% if (i < curIdx) { %><i class="fas fa-check"></i><% } else { %><%= i + 1 %><% } %></div>
                            <div class="l"><%= s %></div>
                        </div>
                    <% }) %>
                </div>
                <div class="row g-3 mt-2">
                    <div class="col-4"><div class="p-3 text-center" style="background:var(--ok-50);border-radius:12px"><div class="fw-bold fs-4" style="color:var(--ok)"><%= approvedDocs %></div><div class="small muted">Onaylı belge</div></div></div>
                    <div class="col-4"><div class="p-3 text-center" style="background:var(--warn-50);border-radius:12px"><div class="fw-bold fs-4" style="color:var(--warn)"><%= pendingDocs %></div><div class="small muted">İncelemede</div></div></div>
                    <div class="col-4"><div class="p-3 text-center" style="background:var(--brand-50);border-radius:12px"><div class="fw-bold fs-4" style="color:var(--brand)"><%= messages.length %></div><div class="small muted">Mesaj</div></div></div>
                </div>
            </div>
        </div>
    </div>
    <!-- YAPILACAKLAR -->
    <div class="col-lg-4">
        <div class="c-card h-100">
            <div class="c-card-h">
                <div class="flex-grow-1"><h2>Yapılacaklar</h2><p class="sub"><%= doneCount %> / <%= todos.length %> tamamlandı</p></div>
                <div style="width:70px"><div class="bar"><span style="width:<%= doneCount / todos.length * 100 %>%;background:var(--ok)"></span></div></div>
            </div>
            <% todos.forEach(t => { %>
                <a href="<%= t.href %>" class="todo <%= t.done ? 'done' : '' %>">
                    <span class="ck"><% if (t.done) { %><i class="fas fa-check"></i><% } %></span>
                    <span class="flex-grow-1"><span class="tt fw-650 d-block"><%= t.t %></span><span class="small muted"><%= t.s %></span></span>
                    <% if (!t.done) { %><i class="fas fa-chevron-right muted small"></i><% } %>
                </a>
            <% }) %>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <!-- HEDEF ŞEHİR -->
    <div class="col-lg-5">
        <% if (targetStateInfo) { %>
        <div class="c-card h-100 overflow-hidden">
            <div class="p-4" style="background:linear-gradient(135deg,#FFE066,#FFCE00);color:#1a1a1a">
                <div class="small fw-bold text-uppercase" style="letter-spacing:1px;opacity:.7">Hedef Şehrin</div>
                <div class="d-flex align-items-center justify-content-between">
                    <h3 class="fw-bold mb-0" style="color:#1a1a1a"><i class="fas fa-location-dot me-2"></i><%= user.targetState %></h3>
                    <div id="target-state-weather" class="text-end"><span class="weather-icon fs-3"><i class="fas fa-spinner fa-spin"></i></span> <span class="weather-temp fw-bold fs-4">--°</span><div class="weather-desc small">Yükleniyor</div></div>
                </div>
            </div>
            <div class="c-card-b"><p class="mb-2"><%= targetStateInfo.desc %></p><a href="/profile" class="small">Hedef şehri değiştir</a></div>
        </div>
        <% } else { %>
        <div class="c-card h-100 c-card-b d-flex flex-column justify-content-center text-center" style="background:var(--warn-50);border-color:#FEDF89">
            <div class="c-ic t-warn mx-auto mb-3" style="width:56px;height:56px;font-size:22px"><i class="fas fa-map-location-dot"></i></div>
            <h3 class="fs-5 fw-bold">Henüz hedef şehir seçmedin</h3>
            <p class="muted small">Almanya'da çalışmak istediğin şehri seçerek danışmanına yardımcı ol.</p>
            <a href="/profile" class="btn btn-brand mx-auto">Şehir seç <i class="fas fa-arrow-right ms-1"></i></a>
        </div>
        <% } %>
    </div>
    <!-- KILAVUZ + KELİME -->
    <div class="col-lg-7">
        <div class="row g-3 h-100">
            <div class="col-md-7">
                <div class="c-card h-100 c-card-b d-flex flex-column">
                    <div class="d-flex gap-3 align-items-start mb-3">
                        <div class="c-ic t-bad"><i class="fas fa-file-pdf"></i></div>
                        <div><h3 class="fs-6 fw-bold mb-1">Lojistik Bilgilendirme Kılavuzu</h3><p class="small muted mb-0">Çalışma koşulları ve vize adımları hakkında bilmen gereken her şey.</p></div>
                    </div>
                    <a href="/100_26_LOJISTIK_BILGILENDIRME.pdf" download class="btn btn-soft mt-auto"><i class="fas fa-download me-1"></i> Kılavuzu indir</a>
                    <% if (typeof globalFiles !== 'undefined' && globalFiles.length) { globalFiles.slice(0, 3).forEach(f => { %>
                        <a href="/uploads/<%= f.filename %>" target="_blank" class="btn btn-soft btn-sm mt-2 text-start"><i class="fas fa-paperclip me-1"></i> <%= f.name %></a>
                    <% }) } %>
                </div>
            </div>
            <div class="col-md-5">
                <div class="word h-100">
                    <span class="pill" style="background:var(--gold);color:#1a1a1a">Günün Kelimesi</span>
                    <% if (typeof dailyWords !== 'undefined' && dailyWords.length) { %>
                        <h3><%= dailyWords[0].german %></h3>
                        <div style="color:rgba(255,255,255,.7)" class="mb-3"><%= dailyWords[0].turkish %></div>
                        <a href="/german" class="btn btn-sm" style="background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.2)">Daha fazla çalış</a>
                    <% } else { %>
                        <p class="mt-3 mb-0" style="color:rgba(255,255,255,.7)">Kelimeler yakında eklenecek.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- MESAJLAR -->
    <div class="col-lg-6">
        <div class="c-card h-100">
            <div class="c-card-h"><h2>Son Mesajlar</h2><a href="/messages" class="btn btn-soft btn-sm ms-auto">Tümü</a></div>
            <% if (messages.length) { messages.slice(0, 4).forEach(m => { %>
                <a href="/messages" class="msg-row">
                    <div class="c-ic t-brand" style="width:36px;height:36px;font-size:14px"><i class="fas fa-user-tie"></i></div>
                    <div class="flex-grow-1" style="min-width:0">
                        <div class="d-flex justify-content-between"><span class="fw-650 text-dark">Danışmanınız <% if (!m.isRead) { %><span class="pill t-bad ms-1" style="font-size:10.5px;padding:1px 7px">Yeni</span><% } %></span><span class="small muted"><%= fmt(m.date) %></span></div>
                        <div class="small muted text-truncate"><%= m.content %></div>
                    </div>
                </a>
            <% }) } else { %>
                <div class="empty"><div class="c-ic t-gray"><i class="far fa-envelope-open"></i></div>Henüz mesajın yok.</div>
            <% } %>
        </div>
    </div>
    <!-- HAVA DURUMU -->
    <div class="col-lg-6">
        <div class="c-card h-100">
            <div class="c-card-h"><div><h2>Almanya'da Hava Durumu</h2><p class="sub">Popüler şehirler, anlık</p></div></div>
            <div class="row g-0">
                <% [['berlin','Berlin'],['hamburg','Hamburg'],['kiel','Kiel'],['hannover','Hannover'],['dortmund','Dortmund'],['gelsenkirchen','Gelsenk.']].forEach(([id, n], i) => { %>
                <div class="col-4" style="<%= i % 3 ? 'border-left:1px solid #F0F2F5;' : '' %><%= i > 2 ? 'border-top:1px solid #F0F2F5;' : '' %>">
                    <div class="wx" id="weather-<%= id %>"><div class="c"><%= n %></div><div class="i weather-icon muted"><i class="fas fa-spinner fa-spin"></i></div><div class="tp weather-temp">--°</div><div class="d weather-desc">…</div></div>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<%- include('partials/cand_shell_end', { page: 'panel' }) %>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const p = new URLSearchParams(location.search);
    if (p.get('login') === 'success') {
        history.replaceState(null, '', location.pathname);
        <% if (locals.unreadCount && unreadCount > 0) { %>
        Swal.fire({ title: 'Yeni mesajın var 📬', text: 'Danışmanından <%= unreadCount %> yeni mesaj aldın.', icon: 'info', confirmButtonText: 'Mesajlara git', confirmButtonColor: '#2F54EB', showCancelButton: true, cancelButtonText: 'Sonra' })
            .then(r => { if (r.isConfirmed) location.href = '/messages'; });
        <% } else { %>
        cToast.fire({ icon: 'success', title: 'Hoş geldin, <%= user.firstName.replace(/'/g, "\\'") %>!' });
        <% } %>
    }

    const info = code => {
        if (code === 0) return ['fa-sun', '#F79009', 'Açık'];
        if ([1, 2, 3].includes(code)) return ['fa-cloud-sun', '#F79009', 'Parçalı bulutlu'];
        if ([45, 48].includes(code)) return ['fa-smog', '#667085', 'Sisli'];
        if ([51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return ['fa-cloud-rain', '#0BA5EC', 'Yağmurlu'];
        if ([71, 73, 75, 77, 85, 86].includes(code)) return ['fa-snowflake', '#0BA5EC', 'Karlı'];
        if (code >= 95) return ['fa-bolt', '#F04438', 'Fırtına'];
        return ['fa-cloud', '#667085', 'Bulutlu'];
    };
    function wx(lat, lon, id) {
        const el = document.getElementById(id); if (!el) return;
        fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`)
            .then(r => r.json()).then(d => {
                const [ic, col, txt] = info(d.current_weather.weathercode);
                el.querySelector('.weather-temp').textContent = Math.round(d.current_weather.temperature) + '°';
                el.querySelector('.weather-desc').textContent = txt;
                const i = el.querySelector('.weather-icon'); i.innerHTML = `<i class="fas ${ic}"></i>`; i.style.color = col;
            }).catch(() => { el.querySelector('.weather-desc').textContent = 'Alınamadı'; el.querySelector('.weather-icon').innerHTML = '<i class="fas fa-cloud"></i>'; });
    }
    const t = <%- JSON.stringify(locals.targetStateInfo || null) %>;
    if (t) wx(t.lat, t.lon, 'target-state-weather');
    [['berlin', 52.52, 13.41], ['hamburg', 53.55, 9.99], ['kiel', 54.32, 10.12], ['hannover', 52.37, 9.73], ['dortmund', 51.51, 7.46], ['gelsenkirchen', 51.51, 7.10]]
        .forEach(([id, a, b]) => wx(a, b, 'weather-' + id));
});
</script>
</body>
</html>
