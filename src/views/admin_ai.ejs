<!DOCTYPE html>
<html lang="tr">
<head>
    <title>AI Asistan | BERLINER Yönetim</title>
    <%- include('partials/admin_head') %>
    <style>
        .chat { display: flex; flex-direction: column; height: calc(100vh - 64px - 48px); min-height: 520px; }
        .msgs { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
        .m { display: flex; gap: 10px; max-width: 860px; }
        .m.me { align-self: flex-end; flex-direction: row-reverse; }
        .m .av { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; flex-shrink: 0; font-size: 14px; }
        .m .bub { background: #fff; border: 1px solid var(--line); border-radius: 14px 14px 14px 4px; padding: 12px 14px; line-height: 1.6; min-width: 0; }
        .m.me .bub { background: var(--brand); color: #fff; border-color: var(--brand); border-radius: 14px 14px 4px 14px; }
        .bub ul { margin: 6px 0 0; padding-left: 18px; }
        .bub table { font-size: 13px; margin: 8px 0 0; }
        .bub .tbl { max-height: 320px; overflow: auto; border: 1px solid var(--line); border-radius: 10px; margin-top: 10px; }
        .bub .tbl thead th { position: sticky; top: 0; background: #F9FAFB; font-size: 12px; color: #667085; font-weight: 600; padding: 7px 10px; }
        .bub .tbl td { padding: 7px 10px; border-top: 1px solid #F0F2F5; }
        .act { border: 1px solid #FEDF89; background: var(--warn-50); border-radius: 12px; padding: 12px; margin-top: 10px; }
        .act.done { border-color: #A6F4C5; background: var(--ok-50); }
        .act.no { opacity: .6; }
        .chips { display: flex; gap: 8px; flex-wrap: wrap; }
        .chip { border: 1px solid var(--line); background: #fff; border-radius: 99px; padding: 6px 12px; font-size: 13px; font-weight: 500; color: var(--ink-2); cursor: pointer; }
        .chip:hover { border-color: #A5B4FC; color: var(--brand); }
        .composer { border-top: 1px solid var(--line); padding: 14px 20px; background: #fff; border-radius: 0 0 var(--radius) var(--radius); }
        .typing span { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #98A2B3; margin: 0 2px; animation: bl 1.2s infinite; }
        .typing span:nth-child(2) { animation-delay: .2s } .typing span:nth-child(3) { animation-delay: .4s }
        @keyframes bl { 0%, 80%, 100% { opacity: .3 } 40% { opacity: 1 } }
        @media (max-width: 991.98px) { .chat { height: calc(100vh - 64px - 32px); } }
    </style>
</head>
<body>
<div class="app">
    <%- include('partials/admin_sidebar', { active: 'ai', onMain: false }) %>
    <div class="main">
        <header class="topbar">
            <button class="btn btn-soft btn-icon menu-toggle" aria-label="Menü"><i class="fas fa-bars"></i></button>
            <div><div class="crumb">Süreç &amp; Otomasyon</div><h1>AI Yönetici Asistanı</h1></div>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="pill <%= aiEnabled ? 't-ok' : 't-gray' %>" title="<%= aiEnabled ? 'Model: ' + model : 'ANTHROPIC_API_KEY tanımlı değil' %>"><i class="fas <%= aiEnabled ? 'fa-wand-magic-sparkles' : 'fa-microchip' %>"></i><%= aiEnabled ? 'Yapay zekâ aktif' : 'Yerel analiz modu' %></span>
                <button class="btn btn-soft btn-sm" id="clearBtn"><i class="fas fa-rotate-left me-1"></i>Yeni sohbet</button>
            </div>
        </header>
        <main class="content" style="padding-bottom:16px">
            <div class="card-x chat">
                <div class="msgs" id="msgs">
                    <div class="m" id="welcome">
                        <div class="av t-brand"><i class="fas fa-wand-magic-sparkles"></i></div>
                        <div class="bub">
                            <div>Merhaba! Adayların 9 aşamalı süreç durumunu, bekleyen işleri ve personel iş yükünü <b>gerçek verilerle</b> analiz edebilirim. Aşama değiştirme veya görev oluşturma gibi işlemleri yalnızca <b>önerir</b>, siz onaylayınca uygularım.</div>
                            <% if (!aiEnabled) { %><div class="small muted mt-2"><i class="fas fa-circle-info me-1"></i>Şu an yerel analiz modundayım: hazır soru kalıplarını yanıtlarım. Serbest sohbet için sunucuya <code>ANTHROPIC_API_KEY</code> eklenmeli.</div><% } %>
                            <div class="chips mt-3">
                                <% ['Şu anda hizmet sözleşmesi aşamasında kaç aday var?', 'Evrak teslimi bekleyen adaylar kimler?', 'Tercüme işlemleri devam eden kaç adayımız var?', 'Ön onay bekleyen adaylarımız kimler?', 'Vize randevusu alan adaylar kimler?', 'Seyahat planı bekleyen kaç kişi var?', "Hangi adaylar Almanya'ya ulaştı?", 'Hangi adaylar uzun süredir aynı aşamada bekliyor?', 'Hangi personelin üzerinde en fazla bekleyen görev var?', 'Genel durum özeti ve öneriler'].forEach(q => { %>
                                    <button class="chip" type="button"><%= q %></button>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                </div>
                <form class="composer d-flex gap-2" id="askForm" data-no-busy>
                    <textarea id="q" class="form-control" rows="1" maxlength="2000" placeholder="Bir soru sorun… (Enter: gönder, Shift+Enter: yeni satır)" style="resize:none"></textarea>
                    <button class="btn btn-brand" id="sendBtn" type="submit"><i class="fas fa-paper-plane"></i></button>
                </form>
            </div>
        </main>
    </div>
</div>
<%- include('partials/admin_scripts') %>
<script>
(function () {
    const box = document.getElementById('msgs'), form = document.getElementById('askForm'), q = document.getElementById('q'), send = document.getElementById('sendBtn');
    let history = [];
    try { history = JSON.parse(sessionStorage.getItem('ai_hist') || '[]'); } catch (e) {}
    const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const md = s => {
        const lines = esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').split('\n');
        let html = '', inList = false;
        for (const l of lines) {
            const m = l.match(/^\s*[-•]\s+(.*)/);
            if (m) { if (!inList) { html += '<ul>'; inList = true; } html += '<li>' + m[1] + '</li>'; }
            else { if (inList) { html += '</ul>'; inList = false; } html += l.trim() ? '<div>' + l + '</div>' : '<div style="height:6px"></div>'; }
        }
        return html + (inList ? '</ul>' : '');
    };
    const scroll = () => box.scrollTop = box.scrollHeight;
    function add(role, html) {
        const d = document.createElement('div'); d.className = 'm' + (role === 'user' ? ' me' : '');
        d.innerHTML = (role === 'user' ? '<div class="av t-gray"><i class="fas fa-user"></i></div>' : '<div class="av t-brand"><i class="fas fa-wand-magic-sparkles"></i></div>') + '<div class="bub">' + html + '</div>';
        box.appendChild(d); scroll(); return d;
    }
    function renderAnswer(r) {
        let h = md(r.text || '');
        if (r.notice) h += '<div class="small mt-2" style="color:#93370D"><i class="fas fa-triangle-exclamation me-1"></i>' + esc(r.notice) + '</div>';
        (r.tables || []).forEach(t => {
            h += '<div class="small fw-bold mt-3">' + esc(t.title || '') + '</div><div class="tbl"><table class="w-100"><thead><tr>' + t.columns.map(c => '<th>' + esc(c) + '</th>').join('') + '</tr></thead><tbody>' +
                t.rows.map((row, i) => '<tr>' + row.map((c, j) => '<td>' + (j === 0 && t.links && t.links[i] ? '<a href="' + esc(t.links[i]) + '" class="text-decoration-none">' + esc(c) + '</a>' : esc(c)) + '</td>').join('') + '</tr>').join('') + '</tbody></table></div>';
        });
        (r.actions || []).forEach(a => {
            h += '<div class="act" data-id="' + esc(a.id) + '"><div class="small fw-bold mb-1"><i class="fas fa-hand me-1"></i>Onayınızı bekleyen işlem</div><div>' + esc(a.summary) + '</div>' +
                ((a.details || []).length ? '<ul class="small mt-1">' + a.details.map(x => '<li>' + esc(x) + '</li>').join('') + '</ul>' : '') +
                '<div class="d-flex gap-2 mt-2"><button class="btn btn-ok btn-sm js-ok"><i class="fas fa-check me-1"></i>Onayla ve uygula</button><button class="btn btn-soft btn-sm js-no">Vazgeç</button></div></div>';
        });
        if (r.mode) h += '<div class="muted mt-2" style="font-size:11px">' + (r.mode === 'ai' ? 'Yapay zekâ · ' + esc(r.model || '') : 'Yerel analiz') + ' · gerçek veriler</div>';
        return h;
    }
    async function ask(text) {
        text = text.trim(); if (!text) return;
        const w = document.getElementById('welcome'); if (w && box.children.length > 1) {}
        add('user', esc(text));
        const t = add('assistant', '<div class="typing"><span></span><span></span><span></span></div>');
        send.disabled = true; q.value = ''; q.style.height = '';
        try {
            const body = new URLSearchParams({ message: text, history: JSON.stringify(history.slice(-8)) });
            const r = await fetch('/admin/asistan/ask', { method: 'POST', headers: { Accept: 'application/json' }, body });
            const d = await r.json();
            if (!r.ok) throw new Error(d.error || 'Hata');
            t.querySelector('.bub').innerHTML = renderAnswer(d);
            history.push({ role: 'user', text }, { role: 'assistant', text: d.text || '' });
            try { sessionStorage.setItem('ai_hist', JSON.stringify(history.slice(-12))); } catch (e) {}
        } catch (e) {
            t.querySelector('.bub').innerHTML = '<span style="color:var(--bad)"><i class="fas fa-circle-exclamation me-1"></i>' + esc(e.message || 'Yanıt alınamadı') + '</span>';
        }
        send.disabled = false; scroll(); q.focus();
    }
    form.addEventListener('submit', e => { e.preventDefault(); e.stopImmediatePropagation(); ask(q.value); });
    q.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); ask(q.value); } });
    q.addEventListener('input', () => { q.style.height = 'auto'; q.style.height = Math.min(140, q.scrollHeight) + 'px'; });
    box.addEventListener('click', async e => {
        const chip = e.target.closest('.chip'); if (chip) return ask(chip.textContent);
        const card = e.target.closest('.act'); if (!card) return;
        if (e.target.closest('.js-ok')) {
            card.querySelectorAll('button').forEach(b => b.disabled = true);
            const r = await fetch('/admin/asistan/confirm/' + card.dataset.id, { method: 'POST', headers: { Accept: 'application/json' } });
            const d = await r.json().catch(() => ({}));
            card.classList.add(r.ok ? 'done' : 'no');
            card.querySelector('.d-flex').innerHTML = r.ok ? '<span class="small fw-semibold" style="color:#027A48"><i class="fas fa-circle-check me-1"></i>' + esc(d.message) + '</span>' : '<span class="small" style="color:var(--bad)"><i class="fas fa-circle-exclamation me-1"></i>' + esc(d.error || 'Uygulanamadı') + '</span>';
        } else if (e.target.closest('.js-no')) {
            await fetch('/admin/asistan/reject/' + card.dataset.id, { method: 'POST', headers: { Accept: 'application/json' } });
            card.classList.add('no'); card.querySelector('.d-flex').innerHTML = '<span class="small muted">Vazgeçildi, değişiklik yapılmadı.</span>';
        }
    });
    document.getElementById('clearBtn').addEventListener('click', () => { history = []; try { sessionStorage.removeItem('ai_hist'); } catch (e) {} [...box.children].forEach(c => { if (c.id !== 'welcome') c.remove(); }); });
    q.focus();
})();
</script>
</body>
</html>
